<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext, because no public authority issues a certificate for a private address. Android scopes cleartext by
  exact host, not range, so this is all-or-nothing and the real boundary is `normalizeServerOrigin` in the client,
  which allows plain HTTP only for loopback and the private ranges.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
