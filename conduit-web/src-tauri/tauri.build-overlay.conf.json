{
  "build": {
    "beforeBuildCommand": ""
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "resources": {
      "companion/": "companion/"
    },
    "icon": [
      "icons/dev/icon.ico",
      "icons/dev/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/dev/icon.ico"
      }
    }
  },
  "version": "0.8.12-dev.20261110065521.g3032a86",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://conduit-local.jask-aran.com/desktop-updates/latest.json"
      ],
      "dangerousInsecureTransportProtocol": true
    }
  },
  "productName": "Conduit Dev",
  "identifier": "com.jaskaran.conduit.desktop.dev",
  "mainBinaryName": "conduit-desktop-dev",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1280,
        "height": 860,
        "minWidth": 520,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "zoomHotkeysEnabled": true,
        "backgroundColor": "#08090A",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --remote-debugging-port=9223 --remote-allow-origins=*"
      }
    ]
  }
}
