{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conduit",
  "version": "0.2.0",
  "identifier": "com.jaskaran.conduit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Conduit",
        "width": 1280,
        "height": 860,
        "minWidth": 520,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "zoomHotkeysEnabled": true,
        "backgroundColor": "#08090A"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/jask-aran/Conduit/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNERUM3MTI2RjQ5RDcyOEEKUldTS2NwMzBKbkhzUFhHNUd2N1N2azd3ZmUyTDNQc2xOdXBrbkN3a3BzczFoNVBHcWErVFVLaHcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
