{
  "name": "@conduit/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build && node scripts/check-bundle.mjs",
    "dev": "vite --host 0.0.0.0",
    "dev:server": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "test:harness": "node scripts/run-harness.mjs",
    "test:harness:browser": "node scripts/run-browser-harness.mjs",
    "qa:agent-browser": "node scripts/run-agent-browser.mjs",
    "perf:live": "node scripts/run-live-harness.mjs",
    "test:browser": "playwright test",
    "test:browser:setpieces": "playwright test test/browser/auth.spec.js test/browser/palette.spec.js test/browser/app.spec.js --workers=1 --grep \"unauthenticated visit|correct password reaches|browses grouped commands|creates a durable chat route|reconnects a live chat after socket loss\" && playwright test test/browser/app.spec.js --project=desktop-chromium --workers=1 --grep \"Workspace views use the nested palette page\" && playwright test test/browser/pwa-mobile.spec.js --workers=1 --grep \"acceptance:\"",
    "test:terminal-performance": "PERF=1 playwright test test/browser/terminal-performance.spec.js --project=desktop-chromium --workers=1",
    "test:terminal-performance:throttled": "PERF=1 PERF_CPU_RATE=4 playwright test test/browser/terminal-performance.spec.js --project=desktop-chromium --workers=1",
    "test:browser:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.6",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@fontsource-variable/geist": "^5.2.9",
    "@jask-aran/solid-components": "0.1.2",
    "@kobalte/core": "0.13.12",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "dompurify": "3.4.12",
    "express": "^4.22.2",
    "ghostty-web": "0.4.0",
    "katex": "^0.16.27",
    "lucide-solid": "1.25.0",
    "marked": "18.0.6",
    "marked-katex-extension": "5.1.10",
    "node-pty": "1.1.0",
    "solid-js": "1.9.14",
    "solid-sonner": "0.3.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "tailwindcss": "^4.3.2",
    "typescript": "7.0.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "2.11.13"
  }
}
