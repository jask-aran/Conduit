{
  "name": "@conduit/web",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/patch-pi-ai.mjs",
    "build": "vite build && node scripts/check-bundle.mjs",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "dev": "vite --host 0.0.0.0",
    "gallery": "vite build --mode gallery && vite preview --mode gallery --outDir dist-gallery --host 0.0.0.0 --port 5180 --strictPort",
    "gallery:dev": "vite --mode gallery --host 0.0.0.0 --port 5180 --strictPort",
    "dev:server": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "test:harness": "node scripts/run-harness.mjs",
    "smoke:panes": "node scripts/panes-smoke.mjs",
    "qa:agent-browser": "node scripts/run-agent-browser.mjs",
    "agent-browser:local": "node scripts/run-agent-browser-command.mjs",
    "perf:live": "node scripts/run-live-harness.mjs",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync android",
    "android:build": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "android:run": "npm run cap:sync && cap run android",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:win": "bash scripts/build-desktop-windows.sh",
    "bench:renderer": "node scripts/bench-renderer.mjs",
    "desktop:dev:win": "bash scripts/dev-desktop-windows.sh"
  },
