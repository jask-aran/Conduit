# Conduit project workflow: these commands are routine repository operations.
# Read-only package metadata checks are exact. Dependency installation remains
# under review because it changes the tree and runs install hooks.
prefix_rule(
    pattern=["npm", "view", "node-pty", "version", "engines", "os", "cpu", "dist.tarball", "--json"],
    decision="allow",
    justification="Read node-pty metadata for Conduit dependency compatibility",
)
prefix_rule(
    pattern=["npm", "view", "@earendil-works/pi-coding-agent", "repository", "homepage", "version", "--json"],
    decision="allow",
    justification="Read Pi coding agent metadata for Conduit dependency compatibility",
)
prefix_rule(
    pattern=["npm", "ls"],
    decision="allow",
    justification="Inspect installed Conduit dependencies",
)
prefix_rule(
    pattern=["npm", "test"],
    decision="allow",
    justification="Run Conduit node:test suites",
)
prefix_rule(
    pattern=["npm", "run", "typecheck"],
    decision="allow",
    justification="Run the required Conduit TypeScript check",
)
prefix_rule(
    pattern=["npm", "run", "build"],
    decision="allow",
    justification="Build the Conduit production bundle",
)
prefix_rule(
    pattern=["npm", "run", "test:browser"],
    decision="allow",
    justification="Run Conduit browser regression tests",
)
prefix_rule(
    pattern=["npx", "playwright", "test", "test/browser/app.spec.js"],
    decision="allow",
    justification="Run Conduit's browser entry-point regression suite with any focused project, grep, worker, or reporter options",
)
prefix_rule(
    pattern=["bash", ".devcontainer/start-conduit.sh", "restart"],
    decision="allow",
    justification="Restart Conduit's managed WSL-accessible server; other script actions remain under review",
)

# Keep managed-server restart as a direct command. Shell wrappers with
# assignments or substitutions are evaluated as one opaque command and do not
# inherit this prefix match.
prefix_rule(
    pattern=["npm", "run", "qa:agent-browser"],
    decision="allow",
    justification="Run Conduit's authenticated local agent-browser QA entry point",
)
prefix_rule(
    pattern=["npm", "run", "test:harness"],
    decision="allow",
    justification="Run Conduit's deterministic local transport harness",
)
prefix_rule(
    pattern=["npm", "run", "test:harness:browser"],
    decision="allow",
    justification="Run Conduit's deterministic local browser harness",
)
prefix_rule(
    pattern=["npm", "run", "test:browser:setpieces"],
    decision="allow",
    justification="Run Conduit's named local browser release canaries",
)
prefix_rule(
    pattern=["node", "--test"],
    decision="allow",
    justification="Run Conduit node:test contract and harness suites",
)
prefix_rule(
    pattern=["curl", "-fsS", "http://127.0.0.1:4310/healthz"],
    decision="allow",
    justification="Check the managed Conduit health endpoint over the local WSL surface",
)

# Repository inspection only. Observed during project review; staging,
# commits, pushes, history changes, and compound shell forms remain under
# review.
prefix_rule(
    pattern=["git", "status", "--short"],
    decision="allow",
    justification="Inspect the Conduit worktree before changes",
)
prefix_rule(
    pattern=["git", "diff", "--check"],
    decision="allow",
    justification="Check Conduit patch whitespace",
)
prefix_rule(
    pattern=["git", "diff", "--cached", "--check"],
    decision="allow",
    justification="Check staged Conduit patch whitespace",
)
prefix_rule(
    pattern=["git", "diff", "--cached", "--name-status"],
    decision="allow",
    justification="Inspect staged Conduit paths",
)

# GitHub inspection only. Repository mutations remain under review.
prefix_rule(
    pattern=["gh", "issue", "list", "--repo", "jask-aran/Conduit"],
    decision="allow",
    justification="List Conduit issues",
)
prefix_rule(
    pattern=["gh", "pr", "view", "--repo", "jask-aran/Conduit"],
    decision="allow",
    justification="Inspect a Conduit pull request",
)
prefix_rule(
    pattern=["gh", "run", "view", "--repo", "jask-aran/Conduit"],
    decision="allow",
    justification="Inspect a Conduit workflow run",
)
prefix_rule(
    pattern=["gh", "release", "view", "--repo", "jask-aran/Conduit"],
    decision="allow",
    justification="Inspect a Conduit release",
)
