#!/usr/bin/env bash
# conduit-server — the Conduit daemon on this computer, and how to manage it.
#
# One service runs whichever code `current` points at: a downloaded release,
# or a development clone (`conduit-server use dev ~/Conduit`). Either way it
# reads the same ~/.conduit/data and answers on the same port, so the browser,
# desktop and phone clients never notice which.
#
#   ~/.local/share/conduit/versions/<v>   releases, replaced whole
#   ~/.local/share/conduit/current        the code the service runs
#   ~/.local/share/conduit/node/<v>       the Node releases run on
#   ~/.conduit/data                       everything durable
#   ~/.conduit/conduit.env                host, port, PATH and other settings
#
# CONDUIT_PROFILE=sandbox (what `install.sh --sandbox` sets up) gives a second,
# separate daemon -- ~/.conduit-sandbox, its own port and service -- for trying
# a fresh install without touching the real one.
set -euo pipefail

PROFILE="${CONDUIT_PROFILE:-}"
SUFFIX="${PROFILE:+-$PROFILE}"
APP_HOME="${CONDUIT_APP_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/conduit$SUFFIX}"
STATE_DIR="${CONDUIT_STATE_DIR:-$HOME/.conduit$SUFFIX}"
export CONDUIT_DATA_ROOT="${CONDUIT_DATA_ROOT:-$STATE_DIR/data}"
ENV_FILE="$STATE_DIR/conduit.env"
LOG_FILE="$STATE_DIR/conduit.log"
PID_FILE="$STATE_DIR/conduit.pid"
NAME="conduit-server$SUFFIX"
UNIT_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$NAME.service"
LABEL="com.conduit.server$SUFFIX"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
REPOSITORY="${CONDUIT_REPOSITORY:-jask-aran/Conduit}"
INSTALL_URL="${CONDUIT_INSTALL_URL:-https://get.jask-aran.com/conduit}"
UV_VERSION="0.11.29"
DEFAULT_PORT=4310; [[ "$PROFILE" == sandbox ]] && DEFAULT_PORT=4321
CURRENT="$APP_HOME/current"
TILDE="~"

# ---------------------------------------------------------------- appearance
# One rail down the left, like the installers people now expect: ┌ opens a
# command, ◆ is a question being asked, ◇ a step done, └ closes it.
if [[ -t 1 && "${TERM:-}" != dumb && -z "${NO_COLOR:-}" ]]; then
  B=$'\e[1m'; D=$'\e[2m'; G=$'\e[32m'; R=$'\e[31m'; Y=$'\e[33m'; C=$'\e[36m'; M=$'\e[35m'; N=$'\e[0m'
  BADGE=$'\e[1;30;46m'
else B=""; D=""; G=""; R=""; Y=""; C=""; M=""; N=""; BADGE=""; fi
if [[ "${LANG:-}${LC_ALL:-}${LC_CTYPE:-}" == *UTF-8* || "${LANG:-}" == *utf8* ]]; then
  S_BAR="│"; S_START="┌"; S_END="└"; S_DONE="◇"; S_ASK="◆"; S_WARN="▲"; S_ERR="■"
  S_ON="●"; S_OFF="○"; S_MASK="▪"; S_TICK="✓"; FRAMES="◒◐◓◑"; S_H="─"; S_TR="╮"; S_BR="╯"; S_LT="├"
else
  S_BAR="|"; S_START="T"; S_END="L"; S_DONE="o"; S_ASK="*"; S_WARN="!"; S_ERR="x"
  S_ON=">"; S_OFF=" "; S_MASK="*"; S_TICK="+"; FRAMES='-\|/'; S_H="-"; S_TR="+"; S_BR="+"; S_LT="+"
fi
TICK="$S_TICK"; ARROW="›"
bar() { printf '%s%s%s\n' "$D" "$S_BAR" "$N"; }
ok() { printf '%s%s%s  %s\n' "$G" "$S_DONE" "$N" "$*"; }
warn() { printf '%s%s%s  %s\n' "$Y" "$S_WARN" "$N" "$*"; }
note() { printf '%s%s  %s%s\n' "$D" "$S_BAR" "$*" "$N"; }
fail() { printf '%s%s%s  %s\n' "$R" "$S_ERR" "$N" "$*" >&2; exit 1; }
row() { printf '%s%s%s  %s%-8s%s %s\n' "$D" "$S_BAR" "$N" "$D" "$1" "$N" "$2"; }
title() {
  if [[ -n "${CONDUIT_RAIL:-}" ]]; then bar; printf '%s%s%s  %s%s%s\n' "$M" "$S_ASK" "$N" "$B" "$*" "$N"
  else printf '\n%s%s%s  %s conduit-server %s  %s\n' "$D" "$S_START" "$N" "$BADGE" "$N" "$*"; fi
  bar
}
outro() { printf '%s%s%s  %s\n\n' "$D" "$S_END" "$N" "$*"; }
plain() { sed 's/\x1b\[[0-9;]*m//g' <<<"$1"; }

# ---------------------------------------------------------------- the code
code_kind() { [[ -f "$CURRENT/NODE_VERSION" ]] && echo release || echo dev; }
code_label() {
  if [[ ! -e "$CURRENT" ]]; then echo "not installed"
  elif [[ "$(code_kind)" == release ]]; then echo "release $(cat "$CURRENT/VERSION")"
  else
    local root; root="$(readlink -f "$CURRENT")"
    echo "dev ${root/#$HOME/$TILDE} @ $(git -C "$root" rev-parse --short HEAD 2>/dev/null || echo '?')"
  fi
}
# A release runs on the Node it was built with; a clone on the Node its
# node_modules were installed with -- the one on PATH.
node_bin() {
  if [[ "$(code_kind)" == release ]]; then
    # The Node install.sh chose: the system's when new enough, else a private copy.
    local chosen; chosen="$(cat "$CURRENT/NODE_BIN" 2>/dev/null || true)"
    if [[ -x "$chosen" ]]; then echo "$chosen"
    elif [[ -x "$APP_HOME/node/$(cat "$CURRENT/NODE_VERSION")/bin/node" ]]; then echo "$APP_HOME/node/$(cat "$CURRENT/NODE_VERSION")/bin/node"
    else command -v node || true; fi
  else command -v node || true; fi
}

# ---------------------------------------------------------------- settings
load_env() {
  CONDUIT_HOST=127.0.0.1; CONDUIT_PORT=$DEFAULT_PORT
  # shellcheck disable=SC1090
  [[ -f "$ENV_FILE" ]] && { set -a; . "$ENV_FILE"; set +a; }
  export CONDUIT_HOST CONDUIT_PORT
}
health_url() { echo "http://127.0.0.1:${CONDUIT_PORT}/healthz"; }
healthy() { curl -fsS --max-time 3 "$(health_url)" >/dev/null 2>&1; }
active_turns() { curl -fsS --max-time 3 "$(health_url)" 2>/dev/null | sed -n 's/.*"activeGenerations":\([0-9]*\).*/\1/p'; }

service_kind() {
  if [[ -n "${CONDUIT_SERVICE:-}" ]]; then echo "$CONDUIT_SERVICE"
  elif [[ "$(uname -s)" == Darwin ]]; then echo launchd
  elif command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then echo systemd
  else echo process; fi
}

# The service runs `current`'s server with the PATH of whoever last started
# it, so it finds the same claude, codex and opencode they do.
write_service() {
  local node; node="$(node_bin)"
  [[ -x "$node" ]] || fail "No Node to run $(code_label) with."
  local extra=""; [[ -f "$STATE_DIR/dev.env" ]] && extra="EnvironmentFile=-$STATE_DIR/dev.env"
  case "$(service_kind)" in
    systemd)
      mkdir -p "$(dirname "$UNIT_FILE")"
      cat >"$UNIT_FILE" <<EOF
[Unit]
Description=Conduit server${PROFILE:+ ($PROFILE)}
After=network-online.target

[Service]
Environment=PATH=$PATH
Environment=CONDUIT_DATA_ROOT=$CONDUIT_DATA_ROOT
Environment=CONDUIT_HOST=$CONDUIT_HOST
Environment=CONDUIT_PORT=$CONDUIT_PORT
EnvironmentFile=-$ENV_FILE
$extra
WorkingDirectory=$HOME
ExecStart=$node $CURRENT/conduit-web/src/server.js
Restart=on-failure
TimeoutStopSec=30

[Install]
WantedBy=default.target
EOF
      systemctl --user daemon-reload ;;
    launchd)
      mkdir -p "$(dirname "$PLIST")"
      cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>-c</string>
    <string>set -a; [ -f "$ENV_FILE" ] &amp;&amp; . "$ENV_FILE"; exec "$node" "$CURRENT/conduit-web/src/server.js"</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>CONDUIT_DATA_ROOT</key><string>$CONDUIT_DATA_ROOT</string>
    <key>CONDUIT_HOST</key><string>$CONDUIT_HOST</string>
    <key>CONDUIT_PORT</key><string>$CONDUIT_PORT</string>
    <key>PATH</key><string>$PATH</string>
  </dict>
  <key>WorkingDirectory</key><string>$HOME</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>$LOG_FILE</string>
  <key>StandardErrorPath</key><string>$LOG_FILE</string>
</dict></plist>
EOF
      ;;
  esac
}

pid_alive() { [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; }

wait_healthy() {
  local frames="$FRAMES" i=0
  for _ in $(seq 1 240); do
    healthy && { [[ -t 1 ]] && printf '\r\e[K'; return 0; }
    [[ "$(service_kind)" == systemd ]] && systemctl --user is-failed -q "$NAME" 2>/dev/null && break
    [[ -t 1 ]] && printf '\r\e[K%s%s%s  Starting %s' "$M" "${frames:i++%${#frames}:1}" "$N" "$(code_label)"
    sleep 0.25
  done
  [[ -t 1 ]] && printf '\r\e[K'; return 1
}

# install.sh fetches a thin release's dependencies in the background while
# setup asks its questions; nothing starts until they are in.
wait_deps() {
  [[ -f "$CURRENT/.deps-pending" ]] || return 0
  local frames="$FRAMES" i=0
  while [[ -f "$CURRENT/.deps-pending" ]]; do
    [[ -t 1 ]] && printf '\r\e[K%s%s%s  Dependencies' "$M" "${frames:i++%${#frames}:1}" "$N"
    sleep 0.15
  done
  [[ -t 1 ]] && printf '\r\e[K'
  [[ -f "$CURRENT/.deps-failed" ]] && { sed "s/^/${D}${S_BAR}${N}    /" "$CURRENT/.deps-failed" | tail -12; fail "Dependencies did not install. Run the installer again."; }
  return 0
}

start() {
  load_env
  wait_deps
  [[ -e "$CURRENT" ]] || fail "Nothing installed. Run the installer, or: conduit-server use dev <clone>"
  mkdir -p "$STATE_DIR" "$CONDUIT_DATA_ROOT"
  case "$(service_kind)" in
    systemd) write_service; systemctl --user enable "$NAME" >/dev/null 2>&1; systemctl --user restart "$NAME" ;;
    launchd) write_service; launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true; launchctl bootstrap "gui/$(id -u)" "$PLIST" ;;
    process)
      pid_alive && kill "$(cat "$PID_FILE")" 2>/dev/null && sleep 1
      cd "$HOME"
      [[ -f "$STATE_DIR/dev.env" ]] && { set -a; . "$STATE_DIR/dev.env"; set +a; }
      nohup setsid "$(node_bin)" "$CURRENT/conduit-web/src/server.js" >>"$LOG_FILE" 2>&1 </dev/null &
      echo $! >"$PID_FILE"; disown ;;
  esac
  wait_healthy || fail "Did not come up. See: $NAME logs"
  ok "Running $(code_label) on ${B}:$CONDUIT_PORT${N}"
}

stop() {
  load_env
  case "$(service_kind)" in
    systemd) systemctl --user stop "$NAME" 2>/dev/null || true ;;
    launchd) launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true ;;
    process) if pid_alive; then kill "$(cat "$PID_FILE")"; rm -f "$PID_FILE"; fi ;;
  esac
  ok "Stopped"
}

# A restart waits for answers still being written, up to ten minutes.
restart() {
  load_env
  local waited=0 turns
  while turns="$(active_turns)" && [[ -n "$turns" && "$turns" -gt 0 && $waited -lt 600 ]]; do
    (( waited == 0 )) && note "Waiting for $turns answer(s) to finish"
    sleep 2; waited=$((waited + 2))
  done
  prepare_browsers
  start
}

# Ready connected browsers for the client this restart brings, as the dev
# launcher does: they install it now, and the restart waits until each
# browser registration says so (native clients never hold it), up to 20s.
# Only when the running server already serves that worker -- a release keeps
# serving its own files until it restarts, and then there is nothing to
# install ahead of time.
prepare_browsers() {
  local sw="$CURRENT/conduit-web/dist/sw.js" target served
  [[ -f "$sw" ]] && healthy || return 0
  curl -fsS --max-time 2 -D - -o /dev/null "$(health_url)" 2>/dev/null | grep -qi '^x-conduit-pwa-prepare: 2' || return 0
  target="$(sha256sum "$sw" | cut -d' ' -f1)"
  served="$(curl -fsS --max-time 3 "http://127.0.0.1:$CONDUIT_PORT/sw.js" 2>/dev/null | sha256sum | cut -d' ' -f1)"
  [[ "$served" == "$target" ]] || return 0
  local out; out="$(auth prepare-restart "$target" 20 2>/dev/null)" && note "$out"
  return 0
}

# Every live connection, one per line: kind, build, how long. Live only.
connected_clients() {
  auth api GET /v0/runtime/clients 2>/dev/null | "$(node_bin)" -e '
    try { const { clients = [] } = JSON.parse(require("fs").readFileSync(0, "utf8"));
      const kind = { android: "Android", desktop: "Desktop" };
      const since = (at) => { const m = Math.max(0, Math.round((Date.now() - Date.parse(at)) / 60000));
        return m < 1 ? "just now" : m < 60 ? m + "m" : m < 1440 ? Math.round(m / 60) + "h" : Math.round(m / 1440) + "d"; };
      for (const c of clients) console.log((kind[c.kind] || "Browser") + "|" + (c.build ? c.build.replace(/\.\d{14}\./, " · ") : "Older build") + " · " + since(c.connectedAt));
    } catch {}' 2>/dev/null
}

running() { healthy; }
status() {
  load_env
  [[ "${1:-}" == --json ]] && { status_json; return; }
  title "$(code_label)"
  if running; then printf '%s%s%s  %sRunning%s\n' "$G" "$S_ON" "$N" "$B" "$N"; else printf '%s%s%s  %sStopped%s %s· %s start%s\n' "$R" "$S_ERR" "$N" "$B" "$N" "$D" "$NAME" "$N"; fi
  row name "$(server_name)"
  if running; then
    local kind detail any=""
    while IFS='|' read -r kind detail; do row "${any:+}${any:-clients}" "$kind ${D}$detail${N}"; any=" "; done < <(connected_clients)
    [[ -n "$any" ]] || row clients "${D}none${N}"
  fi
  local url how cmd; while IFS='|' read -r url how cmd; do row open "${C}$url${N} ${D}$how${N}"; [[ -n "$cmd" ]] && row "" "$cmd"; done < <(access_urls)
  row service "$(service_kind) ${D}$NAME${N}"
  row data "${CONDUIT_DATA_ROOT/#$HOME/$TILDE}"
  row logs "$(log_hint)"
  update_notice
  outro ""
}
log_hint() { [[ "$(service_kind)" == systemd ]] && echo "journalctl --user -u $NAME" || echo "${LOG_FILE/#$HOME/$TILDE}"; }
logs() {
  if [[ "$(service_kind)" == systemd ]]; then exec journalctl --user -u "$NAME" -n 200 -f -o cat
  else exec tail -n 200 -f "$LOG_FILE"; fi
}

# ---------------------------------------------------------------- which code
use() {
  load_env
  local what="${1:-}"
  case "$what" in
    dev)
      local root; root="$(readlink -f "${2:-$PWD}")"
      [[ -f "$root/conduit-web/src/server.js" ]] || fail "$root is not a Conduit clone."
      [[ -d "$root/conduit-web/node_modules" ]] || fail "Install its dependencies first: bash .devcontainer/start-conduit.sh setup"
      [[ -f "$root/conduit-web/dist/index.html" ]] || note "Its client is not built yet: bash .devcontainer/start-conduit.sh build"
      mkdir -p "$APP_HOME"; ln -sfn "$root" "$CURRENT" ;;
    release|latest)
      local newest; newest="$(ls -1t "$APP_HOME/versions" 2>/dev/null | head -1 || true)"
      [[ -n "$newest" ]] || fail "No release installed. Run: $NAME update"
      ln -sfn "$APP_HOME/versions/$newest" "$CURRENT" ;;
    v*|[0-9]*)
      local v="${what#v}"
      [[ -d "$APP_HOME/versions/$v" ]] || fail "Release $v is not installed. Run: $NAME update v$v"
      ln -sfn "$APP_HOME/versions/$v" "$CURRENT" ;;
    "") note "Running $(code_label)"; ls -1t "$APP_HOME/versions" 2>/dev/null | sed "s/^/    /"; return ;;
    *) fail "use dev <clone> | release | v<version>" ;;
  esac
  link_cli
  if [[ "$(code_kind)" == release && ! -x "$CURRENT/working-files/.venv/bin/python" ]]; then
    sync_python && ok "Python tools for this release" || warn "Python tools skipped"
  fi
  ok "Now $(code_label)"
  running && restart || true
}

link_cli() {
  local bin="${CONDUIT_BIN_DIR:-$HOME/.local/bin}"
  mkdir -p "$bin"
  if [[ -n "$PROFILE" ]]; then
    printf '#!/usr/bin/env bash\nCONDUIT_PROFILE=%s exec "%s/scripts/conduit-server" "$@"\n' "$PROFILE" "$CURRENT" >"$bin/$NAME"
    chmod +x "$bin/$NAME"
  else
    ln -sfn "$CURRENT/scripts/conduit-server" "$bin/$NAME"
  fi
}

# ---------------------------------------------------------------- setup
sync_python() {
  local tools="$CONDUIT_DATA_ROOT/toolchains" uv="$CONDUIT_DATA_ROOT/toolchains/uv/$UV_VERSION/uv"
  if [[ ! -x "$uv" ]]; then
    mkdir -p "$(dirname "$uv")"
    curl -fsSL "https://astral.sh/uv/$UV_VERSION/install.sh" | env UV_UNMANAGED_INSTALL="$(dirname "$uv")" sh >/dev/null 2>&1
  fi
  env UV_CACHE_DIR="$tools/uv-cache" UV_PYTHON_INSTALL_DIR="$tools/python" \
    "$uv" sync --project "$CURRENT/working-files" --locked --no-dev --no-install-project \
    --python 3.13 --managed-python --quiet
}

TTY=/dev/tty
# A question settles into "◇ question / │ answer" once answered.
settle() { # settle lines-to-clear "question" "answer"
  printf '\r\e[%dA\e[J%s%s%s  %s\n%s%s  %s%s\n' "$1" "$G" "$S_DONE" "$N" "$2" "$D" "$S_BAR" "$3" "$N" >$TTY
}
ask() { # ask "Question" default -> REPLY; one line, the default there to edit
  printf '%s%s%s  %s  ' "$C" "$S_ASK" "$N" "$1" >$TTY
  IFS= read -r -e -i "${2:-}" REPLY <$TTY 2>$TTY || REPLY=""
  REPLY="${REPLY:-${2:-}}"
  printf '\e[1A\r\e[K%s%s%s  %s  %s%s%s\n' "$G" "$S_DONE" "$N" "$1" "$D" "${REPLY:-(none)}" "$N" >$TTY
}
# line_secret "Label" "hint" -> REPLY: typed as ▪▪▪ on one line, left unfinished
# so the next prompt can take the same line.
line_secret() {
  printf '\r\e[K%s%s%s  %s  %s%s%s' "$C" "$S_ASK" "$N" "$1" "$D" "${2:+$2  }" "$N" >$TTY
  REPLY=""; local ch
  while IFS= read -rsn1 ch <$TTY; do
    case "$ch" in
      "") break ;;
      $'\x7f'|$'\b') [[ -n "$REPLY" ]] && { REPLY="${REPLY%?}"; printf '\b \b' >$TTY; } ;;
      *) REPLY+="$ch"; printf '%s' "$S_MASK" >$TTY ;;
    esac
  done
}
secret() { # secret "Question" -> REPLY, typed as ▪▪▪
  printf '%s%s%s  %s\n%s%s%s  ' "$C" "$S_ASK" "$N" "$1" "$C" "$S_BAR" "$N" >$TTY
  REPLY=""; local ch
  while IFS= read -rsn1 ch <$TTY; do
    case "$ch" in
      "") break ;;
      $'\x7f'|$'\b') [[ -n "$REPLY" ]] && { REPLY="${REPLY%?}"; printf '\b \b' >$TTY; } ;;
      *) REPLY+="$ch"; printf '%s' "$S_MASK" >$TTY ;;
    esac
  done
  printf '\n' >$TTY
  settle 2 "$1" "$(printf "%.0s$S_MASK" $(seq 1 ${#REPLY}))"
}
choose() { # choose "Question" "one" "two" … -> REPLY (1-based); ↑↓/jk/digits, enter
  local q="$1"; shift
  local -a opts=("$@"); local n=$# sel=0 i key rest
  trap 'printf "\e[?25h" >/dev/tty 2>/dev/null || true' EXIT
  printf '%s%s%s  %s\n\e[?25l' "$C" "$S_ASK" "$N" "$q" >$TTY
  _draw() {
    for i in "${!opts[@]}"; do
      if (( i == sel )); then printf '\r\e[K%s%s%s  %s%s%s %s\n' "$C" "$S_BAR" "$N" "$G" "$S_ON" "$N" "${opts[i]}"
      else printf '\r\e[K%s%s%s  %s%s %s%s\n' "$C" "$S_BAR" "$N" "$D" "$S_OFF" "$(plain "${opts[i]}")" "$N"; fi
    done
    printf '\r\e[K%s%s%s  %s↑↓ move · enter select%s' "$C" "$S_END" "$N" "$D" "$N"
  } >$TTY
  _draw
  while IFS= read -rsn1 key <$TTY; do
    if [[ "$key" == $'\e' ]]; then read -rsn2 -t 0.05 rest <$TTY || true; key+="$rest"; fi
    case "$key" in
      $'\e[A'|k) sel=$(( (sel - 1 + n) % n )) ;;
      $'\e[B'|j) sel=$(( (sel + 1) % n )) ;;
      [1-9]) (( key <= n )) && sel=$((key - 1)) ;;
      "") break ;;
    esac
    printf '\e[%dA' "$n" >$TTY; _draw
  done
  local chosen; chosen="$(plain "${opts[sel]}")"; chosen="${chosen%% — *}"
  printf '\e[?25h' >$TTY
  settle "$n" "$q" "$chosen"
  REPLY=$((sel + 1))
}
checklist() { # checklist "Question" "one" "two" … -> REPLY: chosen numbers, space-separated
  local q="$1"; shift
  local -a opts=("$@") on=(); local n=$# sel=0 i key rest
  for i in "${!opts[@]}"; do on[i]=0; done
  # CHECKLIST_ON="1 3" starts those ticked: the current choices, so enter keeps them.
  for i in ${CHECKLIST_ON:-}; do (( i >= 1 && i <= n )) && on[i-1]=1; done
  trap 'printf "\e[?25h" >/dev/tty 2>/dev/null || true' EXIT
  printf '%s%s%s  %s\n\e[?25l' "$C" "$S_ASK" "$N" "$q" >$TTY
  _draw() {
    for i in "${!opts[@]}"; do
      local box="$S_OFF"; (( on[i] )) && box="$S_ON"
      if (( i == sel )); then printf '\r\e[K%s%s%s  %s%s%s %s\n' "$C" "$S_BAR" "$N" "$G" "$box" "$N" "${opts[i]}"
      else printf '\r\e[K%s%s%s  %s%s %s%s\n' "$C" "$S_BAR" "$N" "$D" "$box" "$(plain "${opts[i]}")" "$N"; fi
    done
    printf '\r\e[K%s%s%s  %s↑↓ move · space choose · enter done%s' "$C" "$S_END" "$N" "$D" "$N"
  } >$TTY
  _draw
  while IFS= read -rsn1 key <$TTY; do
    if [[ "$key" == $'\e' ]]; then read -rsn2 -t 0.05 rest <$TTY || true; key+="$rest"; fi
    case "$key" in
      $'\e[A'|k) sel=$(( (sel - 1 + n) % n )) ;;
      $'\e[B'|j) sel=$(( (sel + 1) % n )) ;;
      " "|x) on[sel]=$(( 1 - on[sel] )) ;;
      [1-9]) (( key <= n )) && { sel=$((key - 1)); on[sel]=$(( 1 - on[sel] )); } ;;
      "") break ;;
    esac
    printf '\e[%dA' "$n" >$TTY; _draw
  done
  REPLY=""; local names=()
  for i in "${!opts[@]}"; do (( on[i] )) && { REPLY+="$((i + 1)) "; local c; c="$(plain "${opts[i]}")"; names+=("${c%% — *}"); }; done
  printf '\e[?25h\r\e[%dA\e[J' "$n" >$TTY
  local IFS=","; local summary="${names[*]}"
  printf '%s%s%s  %s  %s%s%s\n' "$G" "$S_DONE" "$N" "$q" "$D" "${summary:-none}" "$N" >$TTY
}
spin() { # spin "message" command… — the rail's spinner, then ◇ and the time it took
  local message="$1"; shift
  local log; log="$(mktemp)"; local started=$SECONDS i=0
  "$@" >"$log" 2>&1 &
  local pid=$!
  if [[ -t 1 ]]; then
    while kill -0 "$pid" 2>/dev/null; do
      printf '\r\e[K%s%s%s  %s %s%ss%s' "$M" "${FRAMES:i++%${#FRAMES}:1}" "$N" "$message" "$D" "$((SECONDS - started))" "$N"; sleep 0.12
    done
    printf '\r\e[K'
  fi
  if wait "$pid"; then ok "$message ${D}$((SECONDS - started))s${N}"; rm -f "$log"
  else warn "$message"; sed "s/^/${D}${S_BAR}${N}    /" "$log" | tail -12; rm -f "$log"; return 1; fi
}
box() { # box "Title" line… — a note hung off the rail
  local t="$1"; shift; local w=${#t} l
  for l in "$@"; do l="$(plain "$l")"; (( ${#l} > w )) && w=${#l}; done
  w=$((w + 4))
  local rule; rule="$(printf "%.0s$S_H" $(seq 1 $((w - ${#t} - 1))))"
  bar
  printf '%s%s%s  %s%s%s %s%s%s%s\n' "$G" "$S_DONE" "$N" "$B" "$t" "$N" "$D" "$rule" "$S_TR" "$N"
  printf '%s%s%*s%s%s\n' "$D" "$S_BAR" "$((w + 2))" "" "$S_BAR" "$N"
  for l in "$@"; do
    local p; p="$(plain "$l")"
    printf '%s%s%s  %s%*s%s%s%s\n' "$D" "$S_BAR" "$N" "$l" "$((w - ${#p}))" "" "$D" "$S_BAR" "$N"
  done
  printf '%s%s%*s%s%s\n' "$D" "$S_BAR" "$((w + 2))" "" "$S_BAR" "$N"
  printf '%s%s%s%s%s\n' "$D" "$S_LT" "$(printf "%.0s$S_H" $(seq 1 $((w + 2))))" "$S_BR" "$N"
}

setup() {
  load_env
  # Python tools build while the questions are asked.
  local py_log; py_log="$(mktemp)"
  ( sync_python >"$py_log" 2>&1 && echo ok >"$py_log.done" || echo fail >"$py_log.done" ) &
  [[ -n "${CONDUIT_RAIL:-}" ]] || title "setup${PROFILE:+ ${D}$PROFILE${N}}"
  if [[ -f "$CONDUIT_DATA_ROOT/auth.json" ]]; then ok "Password ${D}already set${N}"
  else set_password; fi
  set_server_name
  ask "Port" "$CONDUIT_PORT"; set_env CONDUIT_PORT "$REPLY"; load_env
  choose_access
  if [[ "$(service_kind)" == systemd ]] && command -v loginctl >/dev/null 2>&1 \
    && [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != yes ]]; then
    loginctl enable-linger "$USER" >/dev/null 2>&1 || true
  fi
  spin "Finishing" bash -c 'while [ ! -f "$1" ]; do sleep 0.2; done' _ "$py_log.done" || true
  [[ "$(cat "$py_log.done" 2>/dev/null)" == ok ]] || warn "Python tools did not build ${D}· $NAME doctor --fix${N}"
  rm -f "$py_log" "$py_log.done"
  start
  connect_access
  ready_box
  update_notice
  outro "${D}$NAME${N} status · pair · logs · connect"
}
set_server_name() {
  load_env
  local value="${1:-}" default_name="${CONDUIT_SERVER_NAME:-}"
  if [[ -z "$default_name" && -f "${CONDUIT_IDENTITY_FILE:-$CONDUIT_DATA_ROOT/identity.json}" ]]; then
    default_name="$("$(node_bin)" -e 'console.log(JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).name || "")' "${CONDUIT_IDENTITY_FILE:-$CONDUIT_DATA_ROOT/identity.json}" 2>/dev/null || true)"
  fi
  if [[ -z "$value" ]]; then ask "Server name" "${default_name:-$(hostname)}"; value="$REPLY"; fi
  value="$("$(node_bin)" -e '
    const name = process.argv[1].trim();
    if (!name || name.length > 63 || /[\u0000-\u001f\u007f]/.test(name)) {
      console.error("Server name must be 1–63 characters with no control characters."); process.exit(1);
    }
    console.log(name);
  ' "$value")" || fail "Invalid server name"
  # The server owns its name: a running one is renamed in place (clients and
  # the LAN follow); a stopped one has it written where it reads it, and the
  # env var seeds a server that has never started.
  local body; body="$("$(node_bin)" -e 'console.log(JSON.stringify({ name: process.argv[1] }))' "$value")"
  if healthy && auth api PUT /v0/server/name "$body" >/dev/null 2>&1; then
    ok "Server name: $value"; return
  fi
  local file="${CONDUIT_IDENTITY_FILE:-$CONDUIT_DATA_ROOT/identity.json}"
  if [[ -f "$file" ]]; then
    "$(node_bin)" -e '
      const fs = require("fs"); const [file, name] = process.argv.slice(1);
      const saved = JSON.parse(fs.readFileSync(file, "utf8")); saved.name = name;
      fs.writeFileSync(file, JSON.stringify(saved, null, 2) + "\n", { mode: 0o600 });
    ' "$file" "$value" || warn "Could not write the name to $file"
  fi
  local quoted; printf -v quoted '%q' "$value"
  set_env CONDUIT_SERVER_NAME "$quoted"
  ok "Server name: $value"
}
set_password() {
  local hint="" first
  while :; do
    line_secret "Password" "$hint"; first="$REPLY"
    [[ ${#first} -ge 8 ]] || { hint="${Y}at least 8 characters${N}${D}"; continue; }
    line_secret "Password" "once more"
    [[ "$REPLY" == "$first" ]] && break
    hint="${Y}those didn't match${N}${D}"
  done
  printf '%s' "$first" | CONDUIT_DATA_ROOT="$CONDUIT_DATA_ROOT" "$(node_bin)" "$CURRENT/scripts/conduit-auth.mjs" set-password --stdin >/dev/null
  printf '\r\e[K' >$TTY; ok "Password ${D}set${N}"
}

# ---------------------------------------------------------------- reaching it
# Setup asks how Conduit will be reached -- one list for every machine, since a
# desktop may sit behind a tunnel and a VPS may be used only over SSH; what it
# finds (Tailscale signed in, cloudflared) only annotates the choices. The
# server stays on loopback for every choice but "my network".
set_env() {
  mkdir -p "$STATE_DIR"
  { grep -v -E "^$1=" "$ENV_FILE" 2>/dev/null || true; printf '%s=%s\n' "$1" "$2"; } >"$ENV_FILE.tmp"
  mv "$ENV_FILE.tmp" "$ENV_FILE"
}
ts_state() { # missing | stopped | running
  command -v tailscale >/dev/null 2>&1 || { echo missing; return; }
  tailscale status --json 2>/dev/null | grep -q '"BackendState": *"Running"' && echo running || echo stopped
}
ts_name() { tailscale status --json 2>/dev/null | sed -n 's/.*"DNSName": *"\([^"]*\)\.".*/\1/p' | head -1; }
public_ip() { curl -fsS --max-time 3 https://api.ipify.org 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}'; }
lan_ip() { (hostname -I 2>/dev/null || ipconfig getifaddr en0 2>/dev/null) | tr ' ' '\n' | grep -E '^(192\.168|10\.|172\.(1[6-9]|2[0-9]|3[01])\.)' | head -1; }

# This computer always reaches Conduit, so it is not offered. What is asked is
# who else does: devices on this network (which binds 0.0.0.0, publishes the
# server's LAN routes and advertises it on mDNS -- wrong for a VPS, whose
# private addresses are not anybody's Wi-Fi), and the ways in from anywhere.
# Tailscale, a tunnel and SSH all land on loopback, so they need no network.
choose_access() {
  local ts; ts="$(ts_state)" ts_hint="${D}— your devices, anywhere${N}"
  [[ "$ts" == running ]] && ts_hint="${D}— $(ts_name)${N}"
  [[ "$ts" == missing ]] && ts_hint="${D}— installs it${N}"
  local tunnel_hint="${D}— Cloudflare Tunnel, Caddy, nginx…${N}"
  command -v cloudflared >/dev/null 2>&1 && tunnel_hint="${D}— cloudflared found${N}"
  # Ticked to begin with: what is set now, and on a first setup the network.
  local current=""
  if [[ "${CONDUIT_HOST:-}" != 127.0.0.1 ]] || ! grep -q '^CONDUIT_HOST=' "$ENV_FILE" 2>/dev/null; then current+="1 "; fi
  has_access tailscale && current+="2 "; has_access proxy && current+="3 "; has_access ssh && current+="4 "
  note "This computer always reaches it. Choose who else does:"
  CHECKLIST_ON="$current" checklist "Also reach it from" \
    "Devices on this network ${D}— phones and laptops on your Wi-Fi; leave off on a VPS${N}" \
    "Tailscale $ts_hint" \
    "A tunnel or reverse proxy $tunnel_hint" \
    "An SSH tunnel ${D}— for a server you SSH into${N}"
  if [[ " $REPLY " == *" 1 "* ]]; then set_env CONDUIT_HOST 0.0.0.0; else set_env CONDUIT_HOST 127.0.0.1; fi
  local extras=()
  [[ " $REPLY " == *" 2 "* ]] && extras+=(tailscale)
  [[ " $REPLY " == *" 3 "* ]] && extras+=(proxy)
  [[ " $REPLY " == *" 4 "* ]] && extras+=(ssh)
  local IFS=","; set_env CONDUIT_ACCESS "${extras[*]}"; unset IFS
  if [[ " ${extras[*]} " == *" proxy "* ]]; then
    note "Point it at ${N}${C}http://127.0.0.1:$CONDUIT_PORT${N}${D} and let it do HTTPS · e.g. cloudflared tunnel --url http://127.0.0.1:$CONDUIT_PORT"
    ask "Its public address ${D}(optional)${N}" "${CONDUIT_PUBLIC_URL:-}"
    set_env CONDUIT_PUBLIC_URL "$REPLY"
  fi
  load_env
}
has_access() { [[ ",${CONDUIT_ACCESS:-}," == *",$1,"* ]]; }

# Tailscale serve gives the loopback server an HTTPS name on the tailnet.
connect_tailscale() {
  if [[ "$(ts_state)" == missing ]]; then
    if [[ "$(uname -s)" == Darwin ]]; then
      warn "Install Tailscale from ${C}https://tailscale.com/download/mac${N}, sign in, then: $NAME connect"; return 1
    fi
    choose "Install Tailscale now? ${D}It needs sudo once.${N}" "Install it" "Not now"
    [[ "$REPLY" == 2 ]] && { note "Later: curl -fsSL https://tailscale.com/install.sh | sh, then $NAME connect"; return 1; }
    curl -fsSL https://tailscale.com/install.sh | sh </dev/tty || { warn "Tailscale did not install"; return 1; }
  fi
  if [[ "$(ts_state)" != running ]]; then
    note "Sign this machine in to your tailnet:"
    sudo tailscale up </dev/tty || { warn "Tailscale is not signed in. Then: $NAME connect"; return 1; }
  fi
  local out
  if ! out="$(tailscale serve --bg "$CONDUIT_PORT" 2>&1)"; then
    if [[ "$out" == *denied* || "$out" == *operator* ]]; then
      note "Letting $USER manage Tailscale serve (sudo, once):"
      sudo tailscale set --operator="$USER" </dev/tty && out="$(tailscale serve --bg "$CONDUIT_PORT" 2>&1)" || true
    fi
  fi
  if ! tailscale serve status 2>/dev/null | grep -q ":$CONDUIT_PORT"; then
    warn "Tailscale serve did not start:"; printf '%s\n' "$out" | sed 's/^/      /'
    [[ "$out" == *https* || "$out" == *HTTPS* ]] && note "Turn on HTTPS for your tailnet (the link above), then: $NAME connect"
    return 1
  fi
  ok "On your tailnet as ${B}$(ts_name)${N}"
}

connect_access() {
  load_env
  has_access tailscale && { connect_tailscale || true; }
  return 0
}
connect() { load_env; title "How Conduit is reached"; choose_access; healthy && restart >/dev/null; connect_access; ready_box; outro ""; }

# The route words are the apps' (This machine / This network / Tailscale /
# Internet), so the same route reads the same in the terminal and the menu.
access_urls() { # url|route|a command to run, if any
  echo "http://localhost:$CONDUIT_PORT|This machine"
  [[ "$CONDUIT_HOST" == 0.0.0.0 && -n "$(lan_ip)" ]] && echo "http://$(lan_ip):$CONDUIT_PORT|This network"
  if has_access tailscale; then local n; n="$(ts_name)"; [[ -n "$n" ]] && echo "https://$n|Tailscale"; fi
  has_access proxy && [[ -n "${CONDUIT_PUBLIC_URL:-}" ]] && echo "$CONDUIT_PUBLIC_URL|Internet"
  has_access ssh && echo "http://localhost:$CONDUIT_PORT|This machine, over SSH after:|ssh -NL $CONDUIT_PORT:localhost:$CONDUIT_PORT $USER@$(public_ip)"
  return 0
}
# The server's own name, as every client shows it.
server_name() {
  local file="${CONDUIT_IDENTITY_FILE:-$CONDUIT_DATA_ROOT/identity.json}"
  [[ -f "$file" ]] && "$(node_bin)" -e 'console.log(JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).name || "")' "$file" 2>/dev/null && return
  printf '%s\n' "${CONDUIT_SERVER_NAME:-$(hostname)}"
}
ready_box() {
  local -a lines=(); local url how cmd
  while IFS='|' read -r url how cmd; do
    lines+=("${C}${B}$url${N}  ${D}$how${N}")
    [[ -n "$cmd" ]] && lines+=("  ${B}$cmd${N}")
  done < <(access_urls)
  box "$(server_name) is ready" "${lines[@]}"
}

# ---------------------------------------------------------------- releases
auth() { "$(node_bin)" "$CURRENT/scripts/conduit-auth.mjs" "$@"; }
json_str() { local v="${1//\\/\\\\}"; v="${v//\"/\\\"}"; printf '"%s"' "$v"; }

# The newest release on this machine's channel, asked of GitHub at most daily.
latest_release() {
  local cache="$STATE_DIR/latest-release" channel="${CONDUIT_CHANNEL:-stable}"
  if [[ -f "$cache" && -n "$(find "$cache" -mmin -1440 2>/dev/null)" && "$(sed -n 2p "$cache")" == "$channel" ]]; then sed -n 1p "$cache"; return; fi
  local tag
  if [[ "$channel" == beta ]]; then
    tag="$(curl -fsS --max-time 4 "https://api.github.com/repos/$REPOSITORY/releases?per_page=10" 2>/dev/null | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1)"
  else
    tag="$(curl -fsSLI --max-time 4 -o /dev/null -w '%{url_effective}' "https://github.com/$REPOSITORY/releases/latest" 2>/dev/null | sed -n 's#.*/tag/##p')"
  fi
  [[ "$tag" == v* ]] || return 0
  mkdir -p "$STATE_DIR"; printf '%s\n%s\n' "$tag" "$channel" >"$cache"; echo "$tag"
}
update_available() { # prints the newer tag, if this runs a release older than it
  [[ "$(code_kind)" == release ]] || return 0
  [[ "$(cat "$CURRENT/VERSION")" == *local* ]] && return 0
  local latest here; latest="$(latest_release)"; here="v$(cat "$CURRENT/VERSION")"
  [[ -n "$latest" && "$latest" != "$here" && "$(printf '%s\n%s\n' "$here" "$latest" | sort -V | tail -1)" == "$latest" ]] && echo "$latest"
  return 0
}
update_notice() {
  local newer; newer="$(update_available)"
  [[ -n "$newer" ]] && printf '%s%s%s  %s%s available%s %s· %s update%s\n' "$Y" "$S_WARN" "$N" "$B" "$newer" "$N" "$D" "$NAME" "$N"
  return 0
}

update() {
  load_env
  local version=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --channel) [[ "$2" == stable || "$2" == beta ]] || fail "--channel stable|beta"; set_env CONDUIT_CHANNEL "$2"; load_env; rm -f "$STATE_DIR/latest-release"; shift 2 ;;
      *) version="$1"; shift ;;
    esac
  done
  [[ -z "$version" && "${CONDUIT_CHANNEL:-stable}" == beta ]] && version="$(latest_release)"
  curl -fsSL "$INSTALL_URL" | CONDUIT_PROFILE="$PROFILE" bash -s -- --update ${version:+--version "$version"}
  rm -f "$STATE_DIR/latest-release"
}

# ---------------------------------------------------------------- open, sessions
opener() {
  if grep -qi microsoft /proc/version 2>/dev/null; then
    command -v wslview >/dev/null 2>&1 && { echo wslview; return; }
    command -v powershell.exe >/dev/null 2>&1 && { echo powershell; return; }
  fi
  [[ "$(uname -s)" == Darwin ]] && { echo open; return; }
  [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && command -v xdg-open >/dev/null 2>&1 && { echo xdg-open; return; }
  return 0
}
open_cmd() {
  load_env
  healthy || fail "Conduit is not running. $NAME start"
  local base; base="$(access_urls | head -1 | cut -d'|' -f1)"
  local url="$base/v0/auth/handoff?code=$(auth handoff)&after=%2F"
  case "$(opener)" in
    wslview) wslview "$url" ;;
    powershell) powershell.exe -NoProfile -Command "Start-Process '$url'" >/dev/null 2>&1 ;;
    open|xdg-open) "$(opener)" "$url" >/dev/null 2>&1 & ;;
    *) title "Open Conduit"; note "No browser here. Open this within a minute, on a device that can reach it:"; printf '%s%s%s  %s%s%s\n' "$D" "$S_BAR" "$N" "$C" "$url" "$N"; outro ""; return ;;
  esac
  ok "Opened ${C}$base${N} ${D}signed in${N}"
}

# A QR of a one-time, five-minute sign-in link. A phone's camera opens it in
# the browser, signed in; the app's "Scan QR code" redeems the same code for a
# token of its own (POST /v0/auth/native-pair).
pair() {
  load_env
  healthy || fail "Conduit is not running. $NAME start"
  # The address another device is likeliest to reach, from the routes the
  # server has seen (a tunnel shows up there), before the one setup chose.
  # The fragment (never sent by a browser) carries the server's identity and
  # network routes, so the app redeems the code over TLS it vouches for.
  local described base bundle
  described="$(auth api GET /v0/server 2>/dev/null | "$(node_bin)" -e '
    try { const { id, publicKey, paths = [] } = JSON.parse(require("fs").readFileSync(0, "utf8"));
      const rank = { public: 2, private: 1 };
      const routes = paths.filter((p) => rank[p.scope]);
      const best = [...routes].sort((a, b) => rank[b.scope] - rank[a.scope])[0];
      const bundle = id && publicKey ? "#conduit=" + Buffer.from(JSON.stringify({ id, key: publicKey, routes: routes.map((p) => p.origin) })).toString("base64url") : "";
      console.log((best?.origin || "") + "\t" + bundle);
    } catch {}' 2>/dev/null)"
  base="${described%%$'\t'*}"; bundle="${described#*$'\t'}"; [[ "$described" == *$'\t'* ]] || bundle=""
  [[ -n "$base" ]] || base="$(access_urls | cut -d'|' -f1 | grep -v -E '//(localhost|127\.0\.0\.1)[:/]' | head -1)"
  if [[ -z "$base" ]]; then
    title "Pair a device"
    warn "Only this computer can reach Conduit"
    note "Choose Tailscale, a tunnel or your network first: $NAME connect"
    outro ""; return 1
  fi
  local code; code="$(auth handoff 300)"
  local url="$base/v0/auth/handoff?code=$code&after=%2F$bundle"
  title "Pair a device with $(server_name)"
  auth qr "$url" 2>/dev/null | sed "s/^/${D}${S_BAR}${N}  /"
  bar
  note "Scan with the Conduit app (Add server ${ARROW} Scan QR code) or a camera."
  note "Or paste into the app's address field: ${N}${C}$url${N}"
  note "Works once, for five minutes. A camera opens ${N}${B}$base${N}${D}; the app takes the nearest route that proves it is this server."
  bar
  local frames="$FRAMES" i=0 waited=0
  while (( waited < 300 )); do
    if auth handoff-used "$code"; then
      [[ -t 1 ]] && printf '\r\e[K'
      ok "Paired ${D}$NAME sessions lists it${N}"; outro ""; return
    fi
    [[ -t 1 ]] && printf '\r\e[K%s%s%s  Waiting for a scan %s%ss%s' "$M" "${frames:i++%${#frames}:1}" "$N" "$D" "$((300 - waited))" "$N"
    sleep 1; waited=$((waited + 1))
  done
  [[ -t 1 ]] && printf '\r\e[K'
  warn "The code expired. $NAME pair for a new one"; outro ""
}

sessions_cmd() {
  load_env
  if [[ "${1:-}" == revoke ]]; then
    [[ -n "${2:-}" ]] || fail "sessions revoke <id>|all"
    ok "Signed out $(auth revoke "$2") device(s)"; return
  fi
  title "Signed-in devices"
  auth sessions | "$(node_bin)" -e '
    const rows = JSON.parse(require("fs").readFileSync(0, "utf8"));
    const [D, N, C, B] = process.argv.slice(1);
    const ago = (t) => { const s = (Date.now() - Date.parse(t)) / 1000; return s < 120 ? "just now" : s < 7200 ? `${Math.round(s / 60)}m ago` : s < 172800 ? `${Math.round(s / 3600)}h ago` : `${Math.round(s / 86400)}d ago`; };
    const what = (ua, kind) => { if (!ua) return kind; if (/CLI|agent/i.test(ua)) return ua; const os = /Android/.test(ua) ? "Android" : /iPhone|iPad/.test(ua) ? "iOS" : /Windows/.test(ua) ? "Windows" : /Mac OS/.test(ua) ? "macOS" : /Linux/.test(ua) ? "Linux" : ""; const app = kind === "native" ? "Conduit app" : /Edg\//.test(ua) ? "Edge" : /Chrome\//.test(ua) ? "Chrome" : /Firefox\//.test(ua) ? "Firefox" : /Safari\//.test(ua) ? "Safari" : "browser"; return `${app}${os ? ` on ${os}` : ""}`; };
    rows.sort((a, b) => Date.parse(b.lastSeenAt) - Date.parse(a.lastSeenAt));
    for (const r of rows) console.log(`${D}│${N}  ${C}${r.id}${N}  ${what(r.userAgent, r.kind).padEnd(28)} ${D}${ago(r.lastSeenAt)}${N}`);
    if (!rows.length) console.log(`${D}│  nobody is signed in${N}`);
  ' "$D" "$N" "$C" "$B"
  outro "${D}$NAME sessions revoke <id>|all${N}"
}

# ---------------------------------------------------------------- data
backup() {
  load_env
  local lean=0 file=""
  for a in "$@"; do [[ "$a" == --lean ]] && lean=1 || file="$a"; done
  file="${file:-$HOME/conduit-backup-$(date +%Y%m%d-%H%M).tar.gz}"
  local -a skip=(--exclude=./toolchains --exclude=./voice/models --exclude='./*.tmp')
  (( lean )) && skip+=(--exclude=./turn-checkpoints --exclude=./worktrees)
  title "Back up ${CONDUIT_DATA_ROOT/#$HOME/$TILDE}"
  local was=0; healthy && was=1
  (( was )) && { stop >/dev/null; ok "Paused Conduit for a consistent copy"; }
  spin "Archiving" tar -czf "$file" -C "$CONDUIT_DATA_ROOT" "${skip[@]}" . || true
  (( was )) && start >/dev/null && ok "Conduit running again"
  [[ -s "$file" ]] || fail "No backup written"
  ok "${B}${file/#$HOME/$TILDE}${N} ${D}$(du -h "$file" | cut -f1)${N}"
  outro "${D}Restore with $NAME restore <file>; Python tools rebuild with $NAME setup${N}"
}
restore() {
  load_env
  local file="${1:-}"; [[ -f "$file" ]] || fail "restore <backup.tar.gz>"
  title "Restore ${file/#$HOME/$TILDE}"
  choose "Replace ${CONDUIT_DATA_ROOT/#$HOME/$TILDE} with this backup? ${D}The current data is kept beside it.${N}" "Restore" "Cancel"
  [[ "$REPLY" == 1 ]] || { outro "Nothing changed"; return; }
  stop >/dev/null
  local aside; aside="$CONDUIT_DATA_ROOT.before-restore-$(date +%Y%m%d-%H%M%S)"
  mv "$CONDUIT_DATA_ROOT" "$aside" && mkdir -p "$CONDUIT_DATA_ROOT"
  spin "Restoring" tar -xzf "$file" -C "$CONDUIT_DATA_ROOT" || { rm -rf "$CONDUIT_DATA_ROOT"; mv "$aside" "$CONDUIT_DATA_ROOT"; fail "Restore failed; nothing changed"; }
  [[ -d "$aside/toolchains" && ! -e "$CONDUIT_DATA_ROOT/toolchains" ]] && mv "$aside/toolchains" "$CONDUIT_DATA_ROOT/toolchains"
  note "Previous data: ${aside/#$HOME/$TILDE}"
  start
  outro ""
}

# ---------------------------------------------------------------- settings, projects
config_cmd() {
  load_env
  case "${1:-}" in
    get) [[ -n "${2:-}" ]] || fail "config get <KEY>"; sed -n "s/^$2=//p" "$ENV_FILE" 2>/dev/null ;;
    set) [[ -n "${2:-}" && $# -ge 3 ]] || fail "config set <KEY> <value>"
      [[ "$2" =~ ^CONDUIT_[A-Z0-9_]+$ ]] || fail "Settings are CONDUIT_* names"
      set_env "$2" "$3"; ok "$2=$3"; healthy && restart ;;
    unset) [[ -n "${2:-}" ]] || fail "config unset <KEY>"
      grep -v -E "^$2=" "$ENV_FILE" >"$ENV_FILE.tmp" 2>/dev/null || true; mv "$ENV_FILE.tmp" "$ENV_FILE"; ok "Unset $2"; healthy && restart ;;
    ""|list) title "Settings ${D}${ENV_FILE/#$HOME/$TILDE}${N}"
      local k v; while IFS='=' read -r k v; do [[ -n "$k" && "$k" != \#* ]] && row "${k#CONDUIT_}" "$v"; done <"$ENV_FILE" 2>/dev/null
      outro "${D}$NAME config set <KEY> <value>${N}" ;;
    *) fail "config [get|set|unset] <KEY> [value]" ;;
  esac
}

projects_cmd() {
  load_env
  healthy || fail "Conduit is not running. $NAME start"
  case "${1:-}" in
    add)
      local dir; dir="$(cd "${2:-.}" 2>/dev/null && pwd -P)" || fail "No such folder: ${2:-.}"
      local name="${3:-}" body
      body="{\"mode\":\"link\",\"path\":$(json_str "$dir")${name:+,\"name\":$(json_str "$name")}}"
      local reply; reply="$(auth api POST /v0/projects "$body")" \
        || fail "Not added: $(sed -n 's/.*"message":"\([^"]*\)".*/\1/p; t; s/.*"error":"\([^"]*\)".*/\1/p' <<<"$reply")"
      ok "Added ${B}${dir/#$HOME/$TILDE}${N}" ;;
    ""|list)
      title "Projects"
      auth api GET /v0/projects | "$(node_bin)" -e '
        const { projects = [] } = JSON.parse(require("fs").readFileSync(0, "utf8"));
        const [D, N, C, home] = process.argv.slice(1);
        for (const p of projects) console.log(`${D}│${N}  ${C}${String(p.name).padEnd(24)}${N} ${D}${String(p.path || p.workspacePath || "").replace(home, "~")}${N}`);
        if (!projects.length) console.log(`${D}│  none yet: conduit-server projects add <folder>${N}`);
      ' "$D" "$N" "$C" "$HOME"
      outro "" ;;
    *) fail "projects [list|add <folder> [name]]" ;;
  esac
}

rollback() {
  local here previous
  here="$(basename "$(readlink -f "$CURRENT")")"
  previous="$(ls -1t "$APP_HOME/versions" 2>/dev/null | grep -vx "$here" | head -1 || true)"
  [[ -n "$previous" ]] || fail "No earlier release to return to."
  use "$previous"
}

# Each check: state (ok|warn|info) | label | detail | what --fix does
doctor_checks() {
  local node; node="$(node_bin)"
  [[ -x "$node" ]] && echo "ok|Node $("$node" --version)||" || echo "warn|No Node for $(code_label)||"
  [[ -x "$CURRENT/working-files/.venv/bin/python" ]] && echo "ok|Python tools||" || echo "warn|Python tools missing||python"
  [[ -f "$CONDUIT_DATA_ROOT/auth.json" ]] && echo "ok|Login password||" || echo "warn|No login password|$NAME password|"
  if [[ "$(service_kind)" == systemd ]]; then
    [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" == yes ]] && echo "ok|Runs after you log out||" || echo "warn|Stops when you log out|lingering is off|linger"
    if [[ -f "$UNIT_FILE" ]] && ! grep -qF "ExecStart=$node $CURRENT/" "$UNIT_FILE"; then echo "warn|Service file is out of date||service"; fi
  fi
  local newer; newer="$(update_available)"; [[ -n "$newer" ]] && echo "warn|$newer available|$NAME update|"
  local agent auth_file
  for agent in claude:.claude/.credentials.json codex:.codex/auth.json opencode:.local/share/opencode/auth.json; do
    auth_file="$HOME/${agent#*:}"; agent="${agent%%:*}"
    if ! command -v "$agent" >/dev/null 2>&1; then echo "info|$agent not installed||"
    elif [[ -f "$auth_file" ]]; then echo "ok|$agent|$(command -v "$agent" | sed "s#^$HOME#~#")|"
    else echo "warn|$agent is not signed in|run $agent once to sign in|"; fi
  done
  if healthy; then echo "ok|Healthy on :$CONDUIT_PORT||"
  elif (ss -ltn 2>/dev/null || netstat -an 2>/dev/null) | grep -qE "[:.]$CONDUIT_PORT\b.*LISTEN|LISTEN.*[:.]$CONDUIT_PORT\b"; then
    echo "warn|Port $CONDUIT_PORT is taken by something else|$NAME config set CONDUIT_PORT <other>|"
  else echo "warn|Not running||start"; fi
}
doctor() {
  load_env
  local fix=0 as_json=0
  for a in "$@"; do [[ "$a" == --fix ]] && fix=1; [[ "$a" == --json ]] && as_json=1; done
  local checks; checks="$(doctor_checks)"
  if (( as_json )); then
    printf '['; local first=1 state label detail action
    while IFS='|' read -r state label detail action; do
      (( first )) || printf ','; first=0
      printf '{"state":"%s","check":%s,"detail":%s,"fixable":%s}' "$state" "$(json_str "$label")" "$(json_str "$detail")" "$([[ -n "$action" ]] && echo true || echo false)"
    done <<<"$checks"; printf ']\n'; return
  fi
  title "doctor ${D}$(code_label)${N}"
  local state label detail action fixes=()
  while IFS='|' read -r state label detail action; do
    case "$state" in
      ok) ok "$label${detail:+ ${D}$detail${N}}" ;;
      warn) warn "$label${detail:+ ${D}· $detail${N}}${action:+ ${D}(--fix)${N}}" ;;
      *) note "$label" ;;
    esac
    [[ -n "$action" ]] && fixes+=("$action")
  done <<<"$checks"
  if (( fix && ${#fixes[@]} )); then
    bar
    for action in "${fixes[@]}"; do
      case "$action" in
        python) spin "Rebuilding the Python tools" sync_python || true ;;
        linger) loginctl enable-linger "$USER" >/dev/null 2>&1 && ok "Lingering on" || warn "Could not turn on lingering (try: sudo loginctl enable-linger $USER)" ;;
        service) write_service; ok "Service file rewritten"; healthy && restart ;;
        start) start ;;
      esac
    done
  elif (( ${#fixes[@]} )); then bar; note "$NAME doctor --fix sees to the ones marked (--fix)"; fi
  outro ""
}

status_json() {
  local urls="" url how cmd
  while IFS='|' read -r url how cmd; do urls+="${urls:+,}{\"url\":$(json_str "$url"),\"how\":$(json_str "$how")}"; done < <(access_urls)
  printf '{"running":%s,"code":%s,"kind":"%s","port":%s,"access":%s,"urls":[%s],"service":"%s","data":%s,"update":%s}\n' \
    "$(healthy && echo true || echo false)" "$(json_str "$(code_label)")" "$(code_kind)" "$CONDUIT_PORT" \
    "$(json_str "${CONDUIT_ACCESS:-}")" "$urls" "$(service_kind)" "$(json_str "$CONDUIT_DATA_ROOT")" "$(json_str "$(update_available)")"
}

logs_cmd() {
  load_env
  local since="" errors=0
  while [[ $# -gt 0 ]]; do
    case "$1" in --since) since="$2"; shift 2 ;; --errors) errors=1; shift ;; *) shift ;; esac
  done
  local filter=(cat); (( errors )) && filter=(grep -iE --line-buffered "error|fail|exception|unhandled|stalled|warn")
  if [[ "$(service_kind)" == systemd ]]; then
    local -a j=(journalctl --user -u "$NAME" -o cat)
    if [[ -n "$since" ]]; then j+=(--since "-${since}" --no-pager); "${j[@]}" | "${filter[@]}"
    else "${j[@]}" -n 200 -f | "${filter[@]}"; fi
  else
    [[ -n "$since" ]] && note "--since needs the systemd journal; showing the last 500 lines"
    if [[ -n "$since" ]]; then tail -n 500 "$LOG_FILE" | "${filter[@]}"; else tail -n 200 -f "$LOG_FILE" | "${filter[@]}"; fi
  fi
}

report() {
  load_env
  local dir; dir="$(mktemp -d)"; local out="$HOME/conduit-report-$(date +%Y%m%d-%H%M).tar.gz"
  title "Bug report"
  status_json >"$dir/status.json" 2>&1
  doctor --json >"$dir/doctor.json" 2>&1
  { uname -a; echo; cat /etc/os-release 2>/dev/null; echo; "$(node_bin)" --version; } >"$dir/system.txt" 2>&1
  grep -v -iE 'TOKEN|KEY|SECRET|PASSWORD' "$ENV_FILE" >"$dir/conduit.env" 2>/dev/null || true
  # Long opaque strings are tokens more often than not; they are cut out.
  { if [[ "$(service_kind)" == systemd ]]; then journalctl --user -u "$NAME" -o short-iso -n 3000 --no-pager; else tail -n 3000 "$LOG_FILE"; fi; } 2>/dev/null \
    | sed -E 's/[A-Za-z0-9_+\/-]{40,}={0,2}/[redacted]/g; s#'"$HOME"'#~#g' >"$dir/server.log"
  tar -czf "$out" -C "$dir" . && rm -rf "$dir"
  ok "${B}${out/#$HOME/$TILDE}${N} ${D}status, doctor, system, settings and the last 3000 log lines, tokens removed${N}"
  outro "${D}Look it over, then attach it to an issue${N}"
}

completion() {
  local cmds="setup name connect pair status start stop restart logs open sessions use update rollback backup restore config projects password doctor report uninstall completion version help"
  case "${1:-}" in
    bash) printf 'complete -W "%s" %s\n' "$cmds" "$NAME" ;;
    zsh) printf '#compdef %s\n_arguments "1: :(%s)"\n' "$NAME" "$cmds"
      note "Save as a file named _$NAME on your fpath, or: source <($NAME completion zsh)" >&2 ;;
    *) fail "completion bash|zsh" ;;
  esac
}

uninstall() {
  load_env
  # The Tailscale serve entry setup made, if it still points here.
  if has_access tailscale && command -v tailscale >/dev/null 2>&1 \
    && tailscale serve status 2>/dev/null | grep -q "127.0.0.1:$CONDUIT_PORT"; then
    tailscale serve --https=443 off >/dev/null 2>&1 || true
  fi
  stop >/dev/null 2>&1 || true
  [[ "$(service_kind)" == systemd ]] && { systemctl --user disable "$NAME" >/dev/null 2>&1 || true; }
  rm -f "$UNIT_FILE" "$PLIST" "${CONDUIT_BIN_DIR:-$HOME/.local/bin}/$NAME"
  [[ "$(service_kind)" == systemd ]] && systemctl --user daemon-reload 2>/dev/null || true
  rm -rf "$APP_HOME"
  if [[ -n "$PROFILE" ]]; then rm -rf "$STATE_DIR"; ok "Removed the $PROFILE daemon and its data"
  else ok "Removed. Your data stays in ${STATE_DIR/#$HOME/$TILDE}"; fi
}

usage() {
  title "$(code_label)"
  local c
  cmd() { printf '%s%s%s  %s%s%s%*s %s%s%s\n' "$D" "$S_BAR" "$N" "$C" "$1" "$N" $((30 - ${#1})) "" "$D" "$2" "$N"; }
  cmd setup "password, server name, port, access; then start"
  cmd "name [<name>]" "set the server's name; keeps its identity"
  cmd connect "change how it is reached"
  cmd open "open it in the browser, signed in"
  cmd pair "a QR code a phone or the app scans to sign in"
  cmd "status [--json]" "what runs, where, its addresses"
  cmd "start · stop · restart" "restart waits for live answers"
  cmd "logs [--since 1h] [--errors]" "follow or search the server's log"
  bar
  cmd "projects [add <folder>]" "list projects, or add a folder"
  cmd "sessions [revoke <id>]" "signed-in devices; sign one out"
  cmd "config [set K V]" "settings in conduit.env"
  cmd password "change the login password"
  bar
  cmd "update [v] [--channel beta]" "install the latest, or a given, release"
  cmd "use dev <clone> · release" "run a development clone or a release"
  cmd rollback "the release before this one"
  bar
  cmd "backup [--lean] · restore" "archive ~/.conduit/data, or put one back"
  cmd "doctor [--fix] [--json]" "check, and repair, the install"
  cmd report "a bug report bundle, tokens removed"
  cmd "completion bash|zsh" "shell completion"
  cmd uninstall "remove the daemon; keeps ${STATE_DIR/#$HOME/$TILDE}"
  outro ""
}

command="${1:-help}"; shift || true
case "$command" in
  setup) setup ;;
  name) title "Server name"; set_server_name "${1:-}"; outro "" ;;
  connect) connect ;;
  start) start ;;
  stop) stop ;;
  restart) restart ;;
  status) status "$@" ;;
  logs) logs_cmd "$@" ;;
  open) open_cmd ;;
  pair) pair ;;
  sessions) sessions_cmd "$@" ;;
  backup) backup "$@" ;;
  restore) restore "$@" ;;
  config) config_cmd "$@" ;;
  projects) projects_cmd "$@" ;;
  report) report ;;
  completion) completion "$@" ;;
  use) use "$@" ;;
  update) update "$@" ;;
  rollback) rollback ;;
  password) load_env; title "Login password"; set_password; outro "Signed-in browsers and apps will sign in again" ;;
  doctor) doctor "$@" ;;
  uninstall) uninstall ;;
  _sync-python) load_env; sync_python ;;
  _link) link_cli ;;
  version|--version|-v) code_label ;;
  help|--help|-h) usage ;;
  *) usage; exit 2 ;;
esac
