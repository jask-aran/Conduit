#!/usr/bin/env bash
# conduit-server — the Conduit daemon on this computer, and how to manage it.
#
# One service runs whichever code `current` points at: a downloaded release,
# or a development clone (`conduit-server use dev ~/Conduit`). Either way it
# reads the same ~/.conduit/data and answers on the same port, so the browser,
# desktop and phone clients never notice which.
#
#   ~/.local/share/conduit/versions/<v>   releases, replaced whole
#   ~/.local/share/conduit/current        the code the service runs
#   ~/.local/share/conduit/node/<v>       the Node releases run on
#   ~/.conduit/data                       everything durable
#   ~/.conduit/conduit.env                host, port, PATH and other settings
#
# CONDUIT_PROFILE=sandbox (what `install.sh --sandbox` sets up) gives a second,
# separate daemon -- ~/.conduit-sandbox, its own port and service -- for trying
# a fresh install without touching the real one.
set -euo pipefail

PROFILE="${CONDUIT_PROFILE:-}"
SUFFIX="${PROFILE:+-$PROFILE}"
APP_HOME="${CONDUIT_APP_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/conduit$SUFFIX}"
STATE_DIR="${CONDUIT_STATE_DIR:-$HOME/.conduit$SUFFIX}"
export CONDUIT_DATA_ROOT="${CONDUIT_DATA_ROOT:-$STATE_DIR/data}"
ENV_FILE="$STATE_DIR/conduit.env"
LOG_FILE="$STATE_DIR/conduit.log"
PID_FILE="$STATE_DIR/conduit.pid"
NAME="conduit-server$SUFFIX"
UNIT_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$NAME.service"
LABEL="com.conduit.server$SUFFIX"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
REPOSITORY="${CONDUIT_REPOSITORY:-jask-aran/Conduit}"
INSTALL_URL="${CONDUIT_INSTALL_URL:-https://get.jask-aran.com/conduit}"
UV_VERSION="0.11.29"
DEFAULT_PORT=4310; [[ "$PROFILE" == sandbox ]] && DEFAULT_PORT=4321
CURRENT="$APP_HOME/current"
TILDE="~"

# ---------------------------------------------------------------- appearance
# One rail down the left, like the installers people now expect: ┌ opens a
# command, ◆ is a question being asked, ◇ a step done, └ closes it.
if [[ -t 1 && "${TERM:-}" != dumb && -z "${NO_COLOR:-}" ]]; then
  B=$'\e[1m'; D=$'\e[2m'; G=$'\e[32m'; R=$'\e[31m'; Y=$'\e[33m'; C=$'\e[36m'; M=$'\e[35m'; N=$'\e[0m'
  BADGE=$'\e[1;30;46m'
else B=""; D=""; G=""; R=""; Y=""; C=""; M=""; N=""; BADGE=""; fi
if [[ "${LANG:-}${LC_ALL:-}${LC_CTYPE:-}" == *UTF-8* || "${LANG:-}" == *utf8* ]]; then
  S_BAR="│"; S_START="┌"; S_END="└"; S_DONE="◇"; S_ASK="◆"; S_WARN="▲"; S_ERR="■"
  S_ON="●"; S_OFF="○"; S_MASK="▪"; S_TICK="✓"; FRAMES="◒◐◓◑"; S_H="─"; S_TR="╮"; S_BR="╯"; S_LT="├"
else
  S_BAR="|"; S_START="T"; S_END="L"; S_DONE="o"; S_ASK="*"; S_WARN="!"; S_ERR="x"
  S_ON=">"; S_OFF=" "; S_MASK="*"; S_TICK="+"; FRAMES='-\|/'; S_H="-"; S_TR="+"; S_BR="+"; S_LT="+"
fi
TICK="$S_TICK"; ARROW="›"
bar() { printf '%s%s%s\n' "$D" "$S_BAR" "$N"; }
ok() { printf '%s%s%s  %s\n' "$G" "$S_DONE" "$N" "$*"; }
warn() { printf '%s%s%s  %s\n' "$Y" "$S_WARN" "$N" "$*"; }
note() { printf '%s%s  %s%s\n' "$D" "$S_BAR" "$*" "$N"; }
fail() { printf '%s%s%s  %s\n' "$R" "$S_ERR" "$N" "$*" >&2; exit 1; }
row() { printf '%s%s%s  %s%-8s%s %s\n' "$D" "$S_BAR" "$N" "$D" "$1" "$N" "$2"; }
title() {
  if [[ -n "${CONDUIT_RAIL:-}" ]]; then bar; printf '%s%s%s  %s%s%s\n' "$M" "$S_ASK" "$N" "$B" "$*" "$N"
  else printf '\n%s%s%s  %s conduit-server %s  %s\n' "$D" "$S_START" "$N" "$BADGE" "$N" "$*"; fi
  bar
}
outro() { printf '%s%s%s  %s\n\n' "$D" "$S_END" "$N" "$*"; }
plain() { sed 's/\x1b\[[0-9;]*m//g' <<<"$1"; }

# ---------------------------------------------------------------- the code
code_kind() { [[ -f "$CURRENT/NODE_VERSION" ]] && echo release || echo dev; }
code_label() {
  if [[ ! -e "$CURRENT" ]]; then echo "not installed"
  elif [[ "$(code_kind)" == release ]]; then echo "release $(cat "$CURRENT/VERSION")"
  else
    local root; root="$(readlink -f "$CURRENT")"
    echo "dev ${root/#$HOME/$TILDE} @ $(git -C "$root" rev-parse --short HEAD 2>/dev/null || echo '?')"
  fi
}
# A release runs on the Node it was built with; a clone on the Node its
# node_modules were installed with -- the one on PATH.
node_bin() {
  if [[ "$(code_kind)" == release ]]; then echo "$APP_HOME/node/$(cat "$CURRENT/NODE_VERSION")/bin/node"
  else command -v node || true; fi
}

# ---------------------------------------------------------------- settings
load_env() {
  CONDUIT_HOST=127.0.0.1; CONDUIT_PORT=$DEFAULT_PORT
  # shellcheck disable=SC1090
  [[ -f "$ENV_FILE" ]] && { set -a; . "$ENV_FILE"; set +a; }
  export CONDUIT_HOST CONDUIT_PORT
}
health_url() { echo "http://127.0.0.1:${CONDUIT_PORT}/healthz"; }
healthy() { curl -fsS --max-time 3 "$(health_url)" >/dev/null 2>&1; }
active_turns() { curl -fsS --max-time 3 "$(health_url)" 2>/dev/null | sed -n 's/.*"activeGenerations":\([0-9]*\).*/\1/p'; }

service_kind() {
  if [[ -n "${CONDUIT_SERVICE:-}" ]]; then echo "$CONDUIT_SERVICE"
  elif [[ "$(uname -s)" == Darwin ]]; then echo launchd
  elif command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then echo systemd
  else echo process; fi
}

# The service runs `current`'s server with the PATH of whoever last started
# it, so it finds the same claude, codex and opencode they do.
write_service() {
  local node; node="$(node_bin)"
  [[ -x "$node" ]] || fail "No Node to run $(code_label) with."
  local extra=""; [[ -f "$STATE_DIR/dev.env" ]] && extra="EnvironmentFile=-$STATE_DIR/dev.env"
  case "$(service_kind)" in
    systemd)
      mkdir -p "$(dirname "$UNIT_FILE")"
      cat >"$UNIT_FILE" <<EOF
[Unit]
Description=Conduit server${PROFILE:+ ($PROFILE)}
After=network-online.target

[Service]
Environment=PATH=$PATH
Environment=CONDUIT_DATA_ROOT=$CONDUIT_DATA_ROOT
EnvironmentFile=-$ENV_FILE
$extra
WorkingDirectory=$HOME
ExecStart=$node $CURRENT/conduit-web/src/server.js
Restart=on-failure
TimeoutStopSec=30

[Install]
WantedBy=default.target
EOF
      systemctl --user daemon-reload ;;
    launchd)
      mkdir -p "$(dirname "$PLIST")"
      cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>-c</string>
    <string>set -a; [ -f "$ENV_FILE" ] &amp;&amp; . "$ENV_FILE"; exec "$node" "$CURRENT/conduit-web/src/server.js"</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>CONDUIT_DATA_ROOT</key><string>$CONDUIT_DATA_ROOT</string>
    <key>PATH</key><string>$PATH</string>
  </dict>
  <key>WorkingDirectory</key><string>$HOME</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>$LOG_FILE</string>
  <key>StandardErrorPath</key><string>$LOG_FILE</string>
</dict></plist>
EOF
      ;;
  esac
}

pid_alive() { [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; }

wait_healthy() {
  local frames="$FRAMES" i=0
  for _ in $(seq 1 240); do
    healthy && { [[ -t 1 ]] && printf '\r\e[K'; return 0; }
    [[ -t 1 ]] && printf '\r\e[K%s%s%s  Starting %s' "$M" "${frames:i++%${#frames}:1}" "$N" "$(code_label)"
    sleep 0.25
  done
  [[ -t 1 ]] && printf '\r\e[K'; return 1
}

start() {
  load_env
  [[ -e "$CURRENT" ]] || fail "Nothing installed. Run the installer, or: conduit-server use dev <clone>"
  mkdir -p "$STATE_DIR" "$CONDUIT_DATA_ROOT"
  case "$(service_kind)" in
    systemd) write_service; systemctl --user enable "$NAME" >/dev/null 2>&1; systemctl --user restart "$NAME" ;;
    launchd) write_service; launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true; launchctl bootstrap "gui/$(id -u)" "$PLIST" ;;
    process)
      pid_alive && kill "$(cat "$PID_FILE")" 2>/dev/null && sleep 1
      cd "$HOME"
      [[ -f "$STATE_DIR/dev.env" ]] && { set -a; . "$STATE_DIR/dev.env"; set +a; }
      nohup setsid "$(node_bin)" "$CURRENT/conduit-web/src/server.js" >>"$LOG_FILE" 2>&1 </dev/null &
      echo $! >"$PID_FILE"; disown ;;
  esac
  wait_healthy || fail "Did not come up. See: $NAME logs"
  ok "Running $(code_label) on ${B}:$CONDUIT_PORT${N}"
}

stop() {
  load_env
  case "$(service_kind)" in
    systemd) systemctl --user stop "$NAME" 2>/dev/null || true ;;
    launchd) launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true ;;
    process) if pid_alive; then kill "$(cat "$PID_FILE")"; rm -f "$PID_FILE"; fi ;;
  esac
  ok "Stopped"
}

# A restart waits for answers still being written, up to ten minutes.
restart() {
  load_env
  local waited=0 turns
  while turns="$(active_turns)" && [[ -n "$turns" && "$turns" -gt 0 && $waited -lt 600 ]]; do
    (( waited == 0 )) && note "Waiting for $turns answer(s) to finish"
    sleep 2; waited=$((waited + 2))
  done
  start
}

running() { healthy; }
status() {
  load_env
  title "$(code_label)"
  if running; then printf '%s%s%s  %sRunning%s\n' "$G" "$S_ON" "$N" "$B" "$N"; else printf '%s%s%s  %sStopped%s %s· %s start%s\n' "$R" "$S_ERR" "$N" "$B" "$N" "$D" "$NAME" "$N"; fi
  local url how cmd; while IFS='|' read -r url how cmd; do row open "${C}$url${N} ${D}$how${N}"; [[ -n "$cmd" ]] && row "" "$cmd"; done < <(access_urls)
  row service "$(service_kind) ${D}$NAME${N}"
  row data "${CONDUIT_DATA_ROOT/#$HOME/$TILDE}"
  row logs "$(log_hint)"
  outro ""
}
log_hint() { [[ "$(service_kind)" == systemd ]] && echo "journalctl --user -u $NAME" || echo "${LOG_FILE/#$HOME/$TILDE}"; }
logs() {
  if [[ "$(service_kind)" == systemd ]]; then exec journalctl --user -u "$NAME" -n 200 -f -o cat
  else exec tail -n 200 -f "$LOG_FILE"; fi
}

# ---------------------------------------------------------------- which code
use() {
  load_env
  local what="${1:-}"
  case "$what" in
    dev)
      local root; root="$(readlink -f "${2:-$PWD}")"
      [[ -f "$root/conduit-web/src/server.js" ]] || fail "$root is not a Conduit clone."
      [[ -d "$root/conduit-web/node_modules" ]] || fail "Install its dependencies first: bash .devcontainer/start-conduit.sh setup"
      [[ -f "$root/conduit-web/dist/index.html" ]] || note "Its client is not built yet: bash .devcontainer/start-conduit.sh build"
      mkdir -p "$APP_HOME"; ln -sfn "$root" "$CURRENT" ;;
    release|latest)
      local newest; newest="$(ls -1t "$APP_HOME/versions" 2>/dev/null | head -1 || true)"
      [[ -n "$newest" ]] || fail "No release installed. Run: $NAME update"
      ln -sfn "$APP_HOME/versions/$newest" "$CURRENT" ;;
    v*|[0-9]*)
      local v="${what#v}"
      [[ -d "$APP_HOME/versions/$v" ]] || fail "Release $v is not installed. Run: $NAME update v$v"
      ln -sfn "$APP_HOME/versions/$v" "$CURRENT" ;;
    "") note "Running $(code_label)"; ls -1t "$APP_HOME/versions" 2>/dev/null | sed "s/^/    /"; return ;;
    *) fail "use dev <clone> | release | v<version>" ;;
  esac
  link_cli
  if [[ "$(code_kind)" == release && ! -x "$CURRENT/working-files/.venv/bin/python" ]]; then
    sync_python && ok "Python tools for this release" || warn "Python tools skipped"
  fi
  ok "Now $(code_label)"
  running && restart || true
}

link_cli() {
  local bin="${CONDUIT_BIN_DIR:-$HOME/.local/bin}"
  mkdir -p "$bin"
  if [[ -n "$PROFILE" ]]; then
    printf '#!/usr/bin/env bash\nCONDUIT_PROFILE=%s exec "%s/scripts/conduit-server" "$@"\n' "$PROFILE" "$CURRENT" >"$bin/$NAME"
    chmod +x "$bin/$NAME"
  else
    ln -sfn "$CURRENT/scripts/conduit-server" "$bin/$NAME"
  fi
}

# ---------------------------------------------------------------- setup
sync_python() {
  local tools="$CONDUIT_DATA_ROOT/toolchains" uv="$CONDUIT_DATA_ROOT/toolchains/uv/$UV_VERSION/uv"
  if [[ ! -x "$uv" ]]; then
    mkdir -p "$(dirname "$uv")"
    curl -fsSL "https://astral.sh/uv/$UV_VERSION/install.sh" | env UV_UNMANAGED_INSTALL="$(dirname "$uv")" sh >/dev/null 2>&1
  fi
  env UV_CACHE_DIR="$tools/uv-cache" UV_PYTHON_INSTALL_DIR="$tools/python" \
    "$uv" sync --project "$CURRENT/working-files" --locked --no-dev --no-install-project \
    --python 3.13 --managed-python --quiet
}

TTY=/dev/tty
# A question settles into "◇ question / │ answer" once answered.
settle() { # settle lines-to-clear "question" "answer"
  printf '\r\e[%dA\e[J%s%s%s  %s\n%s%s  %s%s\n' "$1" "$G" "$S_DONE" "$N" "$2" "$D" "$S_BAR" "$3" "$N" >$TTY
}
ask() { # ask "Question" default -> REPLY; the default is there to edit
  printf '%s%s%s  %s\n%s%s%s  ' "$C" "$S_ASK" "$N" "$1" "$C" "$S_BAR" "$N" >$TTY
  IFS= read -r -e -i "${2:-}" REPLY <$TTY 2>$TTY || REPLY=""
  REPLY="${REPLY:-${2:-}}"
  settle 2 "$1" "${REPLY:-${D}(none)${N}}"
}
secret() { # secret "Question" -> REPLY, typed as ▪▪▪
  printf '%s%s%s  %s\n%s%s%s  ' "$C" "$S_ASK" "$N" "$1" "$C" "$S_BAR" "$N" >$TTY
  REPLY=""; local ch
  while IFS= read -rsn1 ch <$TTY; do
    case "$ch" in
      "") break ;;
      $'\x7f'|$'\b') [[ -n "$REPLY" ]] && { REPLY="${REPLY%?}"; printf '\b \b' >$TTY; } ;;
      *) REPLY+="$ch"; printf '%s' "$S_MASK" >$TTY ;;
    esac
  done
  printf '\n' >$TTY
  settle 2 "$1" "$(printf "%.0s$S_MASK" $(seq 1 ${#REPLY}))"
}
choose() { # choose "Question" "one" "two" … -> REPLY (1-based); ↑↓/jk/digits, enter
  local q="$1"; shift
  local -a opts=("$@"); local n=$# sel=0 i key rest
  trap 'printf "\e[?25h" >/dev/tty 2>/dev/null || true' EXIT
  printf '%s%s%s  %s\n\e[?25l' "$C" "$S_ASK" "$N" "$q" >$TTY
  _draw() {
    for i in "${!opts[@]}"; do
      if (( i == sel )); then printf '\r\e[K%s%s%s  %s%s%s %s\n' "$C" "$S_BAR" "$N" "$G" "$S_ON" "$N" "${opts[i]}"
      else printf '\r\e[K%s%s%s  %s%s %s%s\n' "$C" "$S_BAR" "$N" "$D" "$S_OFF" "$(plain "${opts[i]}")" "$N"; fi
    done
    printf '\r\e[K%s%s%s  %s↑↓ move · enter select%s' "$C" "$S_END" "$N" "$D" "$N"
  } >$TTY
  _draw
  while IFS= read -rsn1 key <$TTY; do
    if [[ "$key" == $'\e' ]]; then read -rsn2 -t 0.05 rest <$TTY || true; key+="$rest"; fi
    case "$key" in
      $'\e[A'|k) sel=$(( (sel - 1 + n) % n )) ;;
      $'\e[B'|j) sel=$(( (sel + 1) % n )) ;;
      [1-9]) (( key <= n )) && sel=$((key - 1)) ;;
      "") break ;;
    esac
    printf '\e[%dA' "$n" >$TTY; _draw
  done
  local chosen; chosen="$(plain "${opts[sel]}")"; chosen="${chosen%% — *}"
  printf '\e[?25h' >$TTY
  settle "$n" "$q" "$chosen"
  REPLY=$((sel + 1))
}
spin() { # spin "message" command… — the rail's spinner, then ◇ and the time it took
  local message="$1"; shift
  local log; log="$(mktemp)"; local started=$SECONDS i=0
  "$@" >"$log" 2>&1 &
  local pid=$!
  if [[ -t 1 ]]; then
    while kill -0 "$pid" 2>/dev/null; do
      printf '\r\e[K%s%s%s  %s %s%ss%s' "$M" "${FRAMES:i++%${#FRAMES}:1}" "$N" "$message" "$D" "$((SECONDS - started))" "$N"; sleep 0.12
    done
    printf '\r\e[K'
  fi
  if wait "$pid"; then ok "$message ${D}$((SECONDS - started))s${N}"; rm -f "$log"
  else warn "$message"; sed "s/^/${D}${S_BAR}${N}    /" "$log" | tail -12; rm -f "$log"; return 1; fi
}
box() { # box "Title" line… — a note hung off the rail
  local t="$1"; shift; local w=${#t} l
  for l in "$@"; do l="$(plain "$l")"; (( ${#l} > w )) && w=${#l}; done
  w=$((w + 4))
  local rule; rule="$(printf "%.0s$S_H" $(seq 1 $((w - ${#t} - 1))))"
  bar
  printf '%s%s%s  %s%s%s %s%s%s%s\n' "$G" "$S_DONE" "$N" "$B" "$t" "$N" "$D" "$rule" "$S_TR" "$N"
  printf '%s%s%*s%s%s\n' "$D" "$S_BAR" "$((w + 2))" "" "$S_BAR" "$N"
  for l in "$@"; do
    local p; p="$(plain "$l")"
    printf '%s%s%s  %s%*s%s%s%s\n' "$D" "$S_BAR" "$N" "$l" "$((w - ${#p}))" "" "$D" "$S_BAR" "$N"
  done
  printf '%s%s%*s%s%s\n' "$D" "$S_BAR" "$((w + 2))" "" "$S_BAR" "$N"
  printf '%s%s%s%s%s\n' "$D" "$S_LT" "$(printf "%.0s$S_H" $(seq 1 $((w + 2))))" "$S_BR" "$N"
}

setup() {
  load_env
  title "Set up Conduit${PROFILE:+ ${D}($PROFILE)${N}}"
  if [[ -f "$CONDUIT_DATA_ROOT/auth.json" ]]; then ok "Login password ${D}already set · $NAME password to change${N}"
  else set_password; fi
  bar
  ask "Port" "$CONDUIT_PORT"; set_env CONDUIT_PORT "$REPLY"; load_env
  bar
  choose_access
  bar
  spin "Python tools for spreadsheets and documents" sync_python || note "Retry later: $NAME setup"
  if [[ "$(service_kind)" == systemd ]] && command -v loginctl >/dev/null 2>&1 \
    && [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != yes ]]; then
    loginctl enable-linger "$USER" >/dev/null 2>&1 && ok "Keeps running after you log out" || true
  fi
  start
  connect_access
  ready_box
  note "Agents (claude, codex, opencode) come from PATH, with their own logins."
  outro "Manage it with ${B}$NAME${N} status · logs · connect · update"
}
set_password() {
  while :; do
    secret "Choose a login password"; local first="$REPLY"
    [[ ${#first} -ge 8 ]] || { warn "At least 8 characters"; continue; }
    secret "Once more"
    [[ "$REPLY" == "$first" ]] && break
    warn "Those didn't match"
  done
  printf '%s' "$first" | CONDUIT_DATA_ROOT="$CONDUIT_DATA_ROOT" "$(node_bin)" "$CURRENT/scripts/conduit-auth.mjs" set-password --stdin >/dev/null
  printf '\e[4A\r\e[J' >$TTY; ok "Login password ${D}set${N}"
}

# ---------------------------------------------------------------- reaching it
# Setup asks how Conduit will be reached -- one list for every machine, since a
# desktop may sit behind a tunnel and a VPS may be used only over SSH; what it
# finds (Tailscale signed in, cloudflared) only annotates the choices. The
# server stays on loopback for every choice but "my network".
set_env() {
  mkdir -p "$STATE_DIR"
  { grep -v -E "^$1=" "$ENV_FILE" 2>/dev/null || true; printf '%s=%s\n' "$1" "$2"; } >"$ENV_FILE.tmp"
  mv "$ENV_FILE.tmp" "$ENV_FILE"
}
ts_state() { # missing | stopped | running
  command -v tailscale >/dev/null 2>&1 || { echo missing; return; }
  tailscale status --json 2>/dev/null | grep -q '"BackendState": *"Running"' && echo running || echo stopped
}
ts_name() { tailscale status --json 2>/dev/null | sed -n 's/.*"DNSName": *"\([^"]*\)\.".*/\1/p' | head -1; }
public_ip() { curl -fsS --max-time 3 https://api.ipify.org 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}'; }
lan_ip() { (hostname -I 2>/dev/null || ipconfig getifaddr en0 2>/dev/null) | tr ' ' '\n' | grep -E '^(192\.168|10\.|172\.(1[6-9]|2[0-9]|3[01])\.)' | head -1; }

choose_access() {
  local ts; ts="$(ts_state)" ts_hint="${D}— your phone and other computers, from anywhere${N}"
  [[ "$ts" == running ]] && ts_hint="${D}— $(ts_name) is signed in${N}"
  [[ "$ts" == missing ]] && ts_hint="${D}— installs it, free for personal use${N}"
  local tunnel_hint="${D}— Cloudflare Tunnel, ngrok, Caddy, nginx…${N}"
  command -v cloudflared >/dev/null 2>&1 && tunnel_hint="${D}— cloudflared is installed${N}"
  choose "How will you open Conduit?" \
    "Just this computer ${D}— the browser here, or the desktop app${N}" \
    "Tailscale $ts_hint" \
    "A tunnel or reverse proxy I run $tunnel_hint" \
    "An SSH tunnel ${D}— for a server you SSH into; nothing to install${N}" \
    "Any device on my network ${D}— $(lan_ip):$CONDUIT_PORT, no HTTPS${N}"
  case "$REPLY" in 2) ACCESS=tailscale ;; 3) ACCESS=proxy ;; 4) ACCESS=ssh ;; 5) ACCESS=lan ;; *) ACCESS=local ;; esac
  set_env CONDUIT_ACCESS "$ACCESS"
  set_env CONDUIT_HOST "$([[ "$ACCESS" == lan ]] && echo 0.0.0.0 || echo 127.0.0.1)"
  if [[ "$ACCESS" == proxy ]]; then
    box "Point your tunnel or proxy at" \
      "${C}${B}http://127.0.0.1:$CONDUIT_PORT${N}" \
      "" \
      "${D}cloudflared${N}  cloudflared tunnel --url http://127.0.0.1:$CONDUIT_PORT" \
      "${D}Caddy${N}        reverse_proxy 127.0.0.1:$CONDUIT_PORT" \
      "" \
      "${D}It does HTTPS; WebSockets must pass through (they do by default).${N}"
    bar
    ask "Its public address ${D}optional, shown in status${N}" "${CONDUIT_PUBLIC_URL:-}"
    set_env CONDUIT_PUBLIC_URL "$REPLY"
  fi
  load_env
}

# Tailscale serve gives the loopback server an HTTPS name on the tailnet.
connect_tailscale() {
  if [[ "$(ts_state)" == missing ]]; then
    if [[ "$(uname -s)" == Darwin ]]; then
      warn "Install Tailscale from ${C}https://tailscale.com/download/mac${N}, sign in, then: $NAME connect"; return 1
    fi
    choose "Install Tailscale now? ${D}It needs sudo once.${N}" "Install it" "Not now"
    [[ "$REPLY" == 2 ]] && { note "Later: curl -fsSL https://tailscale.com/install.sh | sh, then $NAME connect"; return 1; }
    curl -fsSL https://tailscale.com/install.sh | sh </dev/tty || { warn "Tailscale did not install"; return 1; }
  fi
  if [[ "$(ts_state)" != running ]]; then
    note "Sign this machine in to your tailnet:"
    sudo tailscale up </dev/tty || { warn "Tailscale is not signed in. Then: $NAME connect"; return 1; }
  fi
  local out
  if ! out="$(tailscale serve --bg "$CONDUIT_PORT" 2>&1)"; then
    if [[ "$out" == *denied* || "$out" == *operator* ]]; then
      note "Letting $USER manage Tailscale serve (sudo, once):"
      sudo tailscale set --operator="$USER" </dev/tty && out="$(tailscale serve --bg "$CONDUIT_PORT" 2>&1)" || true
    fi
  fi
  if ! tailscale serve status 2>/dev/null | grep -q ":$CONDUIT_PORT"; then
    warn "Tailscale serve did not start:"; printf '%s\n' "$out" | sed 's/^/      /'
    [[ "$out" == *https* || "$out" == *HTTPS* ]] && note "Turn on HTTPS for your tailnet (the link above), then: $NAME connect"
    return 1
  fi
  ok "On your tailnet as ${B}$(ts_name)${N}"
}

connect_access() {
  load_env
  case "${CONDUIT_ACCESS:-local}" in
    tailscale) connect_tailscale || true ;;
  esac
}
connect() { load_env; title "How Conduit is reached"; choose_access; healthy && restart >/dev/null; connect_access; ready_box; outro ""; }

access_urls() { # url|how to get there|a command to run, if any
  local access="${CONDUIT_ACCESS:-}"
  [[ -z "$access" ]] && { [[ "$CONDUIT_HOST" == 0.0.0.0 ]] && access=lan || access=local; }
  case "$access" in
    tailscale) local n; n="$(ts_name)"
      [[ -n "$n" ]] && echo "https://$n|from any device signed in to your tailnet"
      echo "http://localhost:$CONDUIT_PORT|on this computer" ;;
    ssh) echo "http://localhost:$CONDUIT_PORT|on your computer, while this runs on it:|ssh -NL $CONDUIT_PORT:localhost:$CONDUIT_PORT $USER@$(public_ip)" ;;
    proxy) [[ -n "${CONDUIT_PUBLIC_URL:-}" ]] && echo "$CONDUIT_PUBLIC_URL|through your tunnel or proxy"
      echo "http://127.0.0.1:$CONDUIT_PORT|what the tunnel or proxy points at" ;;
    lan) echo "http://$(lan_ip):$CONDUIT_PORT|from devices on this network"; echo "http://localhost:$CONDUIT_PORT|on this computer" ;;
    *) echo "http://localhost:$CONDUIT_PORT|on this computer, or the desktop app" ;;
  esac
}
ready_box() {
  local -a lines=(); local url how cmd first=1
  while IFS='|' read -r url how cmd; do
    (( first )) || lines+=("")
    first=0
    lines+=("${C}${B}$url${N}" "${D}$how${N}")
    [[ -n "$cmd" ]] && lines+=("${B}$cmd${N}")
  done < <(access_urls)
  box "Conduit is ready" "${lines[@]}"
}

# ---------------------------------------------------------------- releases
update() {
  local version="${1:-}"
  curl -fsSL "$INSTALL_URL" | CONDUIT_PROFILE="$PROFILE" bash -s -- --update ${version:+--version "$version"}
}

rollback() {
  local here previous
  here="$(basename "$(readlink -f "$CURRENT")")"
  previous="$(ls -1t "$APP_HOME/versions" 2>/dev/null | grep -vx "$here" | head -1 || true)"
  [[ -n "$previous" ]] || fail "No earlier release to return to."
  use "$previous"
}

doctor() {
  load_env
  title "doctor"
  local node; node="$(node_bin)"
  row code "$(code_label)"
  [[ -x "$node" ]] && ok "Node $("$node" --version)" || warn "No Node for this code"
  [[ -x "$CURRENT/working-files/.venv/bin/python" ]] && ok "Python tools" || warn "Python tools missing ${D}($NAME setup)${N}"
  [[ -f "$CONDUIT_DATA_ROOT/auth.json" ]] && ok "Login password" || warn "No login password ${D}($NAME password)${N}"
  for agent in claude codex opencode2 opencode; do
    command -v "$agent" >/dev/null 2>&1 && ok "$agent ${D}$(command -v "$agent" | sed "s#^$HOME#~#")${N}" || note "$agent not found"
  done
  healthy && ok "Healthy on :$CONDUIT_PORT" || warn "Not running ${D}($NAME start)${N}"
  outro ""
}

uninstall() {
  stop >/dev/null 2>&1 || true
  [[ "$(service_kind)" == systemd ]] && { systemctl --user disable "$NAME" >/dev/null 2>&1 || true; }
  rm -f "$UNIT_FILE" "$PLIST" "${CONDUIT_BIN_DIR:-$HOME/.local/bin}/$NAME"
  [[ "$(service_kind)" == systemd ]] && systemctl --user daemon-reload 2>/dev/null || true
  rm -rf "$APP_HOME"
  if [[ -n "$PROFILE" ]]; then rm -rf "$STATE_DIR"; ok "Removed the $PROFILE daemon and its data"
  else ok "Removed. Your data stays in ${STATE_DIR/#$HOME/$TILDE}"; fi
}

usage() {
  title "$(code_label)"
  local c
  cmd() { printf '%s%s%s  %s%s%s%*s %s%s%s\n' "$D" "$S_BAR" "$N" "$C" "$1" "$N" $((22 - ${#1})) "" "$D" "$2" "$N"; }
  cmd setup "password, port, how it is reached; then start"
  cmd connect "change how it is reached"
  cmd status "what runs, where, its addresses"
  cmd "start · stop · restart" "restart waits for live answers"
  cmd logs "follow the server's log"
  bar
  cmd "use dev <clone>" "run a development clone"
  cmd "use release · v<ver>" "run an installed release"
  cmd "update [v]" "install the latest, or a given, release"
  cmd rollback "the release before this one"
  bar
  cmd password "change the login password"
  cmd doctor "check Node, Python, agents, the server"
  cmd uninstall "remove the daemon; keeps ${STATE_DIR/#$HOME/$TILDE}"
  outro ""
}

command="${1:-help}"; shift || true
case "$command" in
  setup) setup ;;
  connect) connect ;;
  start) start ;;
  stop) stop ;;
  restart) restart ;;
  status) status ;;
  logs) logs ;;
  use) use "$@" ;;
  update) update "$@" ;;
  rollback) rollback ;;
  password) load_env; title "Login password"; set_password; outro "Signed-in browsers and apps will sign in again" ;;
  doctor) doctor ;;
  uninstall) uninstall ;;
  _sync-python) load_env; sync_python ;;
  _link) link_cli ;;
  version|--version|-v) code_label ;;
  help|--help|-h) usage ;;
  *) usage; exit 2 ;;
esac
