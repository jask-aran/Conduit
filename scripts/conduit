#!/usr/bin/env bash
# conduit — run and manage an installed Conduit server.
#
# Installed layout (see docs/design/install-command.md):
#   ~/.local/share/conduit/versions/<v>   one release, replaced whole
#   ~/.local/share/conduit/current        the running release
#   ~/.local/share/conduit/node/<v>       the Node it runs on
#   ~/.conduit/data                       everything durable
#   ~/.conduit/conduit.env                host, port and other settings
set -euo pipefail

APP_HOME="${CONDUIT_APP_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/conduit}"
STATE_DIR="${CONDUIT_STATE_DIR:-$HOME/.conduit}"
export CONDUIT_DATA_ROOT="${CONDUIT_DATA_ROOT:-$STATE_DIR/data}"
ENV_FILE="$STATE_DIR/conduit.env"
LOG_FILE="$STATE_DIR/conduit.log"
PID_FILE="$STATE_DIR/conduit.pid"
UNIT="conduit.service"
UNIT_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT"
PLIST="$HOME/Library/LaunchAgents/com.conduit.server.plist"
REPOSITORY="${CONDUIT_REPOSITORY:-jask-aran/Conduit}"
UV_VERSION="0.11.29"

# The release this script belongs to: the directory above bin/.
RELEASE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
VERSION="$(cat "$RELEASE/VERSION" 2>/dev/null || echo dev)"
NODE_VERSION="$(cat "$RELEASE/NODE_VERSION" 2>/dev/null || true)"
NODE="$APP_HOME/node/$NODE_VERSION/bin/node"
[[ -x "$NODE" ]] || NODE="$(command -v node || true)"

if [[ -t 1 ]]; then
  B=$'\e[1m'; D=$'\e[2m'; G=$'\e[32m'; R=$'\e[31m'; C=$'\e[36m'; N=$'\e[0m'
else B=""; D=""; G=""; R=""; C=""; N=""; fi
say() { printf '%s\n' "$*"; }
ok() { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
fail() { printf '  %s✗%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
step() { printf '  %s·%s %s\n' "$D" "$N" "$*"; }

load_env() {
  CONDUIT_HOST=127.0.0.1; CONDUIT_PORT=4310
  # shellcheck disable=SC1090
  [[ -f "$ENV_FILE" ]] && set -a && . "$ENV_FILE" && set +a
  export CONDUIT_HOST CONDUIT_PORT
}

health_url() { echo "http://127.0.0.1:${CONDUIT_PORT}/healthz"; }
healthy() { curl -fsS --max-time 2 "$(health_url)" >/dev/null 2>&1; }
active_turns() { curl -fsS --max-time 2 "$(health_url)" 2>/dev/null | sed -n 's/.*"activeGenerations":\([0-9]*\).*/\1/p'; }

service_kind() {
  if [[ -n "${CONDUIT_SERVICE:-}" ]]; then echo "$CONDUIT_SERVICE"
  elif [[ "$(uname -s)" == "Darwin" ]]; then echo launchd
  elif command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then echo systemd
  else echo process; fi
}

# What the service runs: the current release's server on the bundled Node.
write_service() {
  local current="$APP_HOME/current" node="$NODE"
  case "$(service_kind)" in
    systemd)
      mkdir -p "$(dirname "$UNIT_FILE")"
      cat >"$UNIT_FILE" <<EOF
[Unit]
Description=Conduit
After=network-online.target

[Service]
EnvironmentFile=-$ENV_FILE
Environment=CONDUIT_DATA_ROOT=$CONDUIT_DATA_ROOT
Environment=PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=$node $current/conduit-web/src/server.js
Restart=on-failure
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
EOF
      systemctl --user daemon-reload ;;
    launchd)
      mkdir -p "$(dirname "$PLIST")"
      cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.conduit.server</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>-c</string>
    <string>set -a; [ -f "$ENV_FILE" ] &amp;&amp; . "$ENV_FILE"; exec "$node" "$current/conduit-web/src/server.js"</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>CONDUIT_DATA_ROOT</key><string>$CONDUIT_DATA_ROOT</string>
    <key>PATH</key><string>$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>$LOG_FILE</string>
  <key>StandardErrorPath</key><string>$LOG_FILE</string>
</dict></plist>
EOF
      ;;
    process) : ;;
  esac
}

pid_alive() { [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; }

start() {
  load_env
  [[ -x "$NODE" ]] || fail "Node is missing; reinstall Conduit."
  mkdir -p "$STATE_DIR" "$CONDUIT_DATA_ROOT"
  case "$(service_kind)" in
    systemd) write_service; systemctl --user enable --now "$UNIT" >/dev/null 2>&1 || systemctl --user start "$UNIT" ;;
    launchd) write_service; launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || launchctl kickstart -k "gui/$(id -u)/com.conduit.server" ;;
    process)
      pid_alive && { ok "Already running"; return; }
      cd "$HOME"
      nohup setsid "$NODE" "$APP_HOME/current/conduit-web/src/server.js" >>"$LOG_FILE" 2>&1 </dev/null &
      echo $! >"$PID_FILE"; disown ;;
  esac
  for _ in $(seq 1 60); do healthy && { ok "Conduit is running on port $CONDUIT_PORT"; return; }; sleep 1; done
  fail "Conduit did not become healthy; see: conduit logs"
}

stop() {
  load_env
  case "$(service_kind)" in
    systemd) systemctl --user stop "$UNIT" 2>/dev/null || true ;;
    launchd) launchctl bootout "gui/$(id -u)/com.conduit.server" 2>/dev/null || true ;;
    process) pid_alive && kill "$(cat "$PID_FILE")" && rm -f "$PID_FILE" || true ;;
  esac
  ok "Stopped"
}

# A restart waits for answers still being written, up to ten minutes.
restart() {
  load_env
  local waited=0 turns
  while turns="$(active_turns)" && [[ -n "$turns" && "$turns" -gt 0 && $waited -lt 600 ]]; do
    (( waited == 0 )) && step "Waiting for $turns answer(s) to finish"
    sleep 2; waited=$((waited + 2))
  done
  stop >/dev/null; start
}

status() {
  load_env
  printf '  %sConduit%s %s\n' "$B" "$N" "$VERSION"
  if healthy; then ok "Running on http://${CONDUIT_HOST}:${CONDUIT_PORT} ($(service_kind))"
  else printf '  %s✗%s Not running (%s)\n' "$R" "$N" "$(service_kind)"; fi
  printf '  %s·%s Data   %s\n' "$D" "$N" "$CONDUIT_DATA_ROOT"
  printf '  %s·%s Logs   %s\n' "$D" "$N" "$(log_hint)"
}

log_hint() { [[ "$(service_kind)" == systemd ]] && echo "journalctl --user -u conduit" || echo "$LOG_FILE"; }
logs() {
  if [[ "$(service_kind)" == systemd ]]; then exec journalctl --user -u "$UNIT" -n 200 -f
  else exec tail -n 200 -f "$LOG_FILE"; fi
}

# The working-files Python environment, from the release's lock, with uv and
# Python kept under the data root as a development checkout keeps them.
sync_python() {
  local tools="$CONDUIT_DATA_ROOT/toolchains" uv="$CONDUIT_DATA_ROOT/toolchains/uv/$UV_VERSION/uv"
  if [[ ! -x "$uv" ]]; then
    mkdir -p "$(dirname "$uv")"
    curl -fsSL "https://astral.sh/uv/$UV_VERSION/install.sh" | env UV_UNMANAGED_INSTALL="$(dirname "$uv")" sh >/dev/null 2>&1
  fi
  env UV_CACHE_DIR="$tools/uv-cache" UV_PYTHON_INSTALL_DIR="$tools/python" \
    "$uv" sync --project "$RELEASE/working-files" --locked --no-dev --no-install-project \
    --python 3.13 --managed-python --quiet
}

ask() { # ask "Question" default -> REPLY
  local prompt="$1" default="${2:-}"
  printf '  %s?%s %s %s' "$C" "$N" "$prompt" "${default:+${D}($default)${N} }" >/dev/tty
  read -r REPLY </dev/tty || REPLY=""
  REPLY="${REPLY:-$default}"
}

choose() { # choose "Question" "one" "two" ... -> REPLY (index from 1)
  local prompt="$1"; shift
  printf '  %s?%s %s\n' "$C" "$N" "$prompt" >/dev/tty
  local i=1; for option in "$@"; do printf '    %s%d%s  %s\n' "$B" "$i" "$N" "$option" >/dev/tty; i=$((i + 1)); done
  printf '    %s›%s ' "$C" "$N" >/dev/tty
  read -r REPLY </dev/tty || REPLY=1
  [[ "$REPLY" =~ ^[0-9]+$ && "$REPLY" -ge 1 && "$REPLY" -le $# ]] || REPLY=1
}

# The one setup after install: a password, who can reach it, and start.
setup() {
  load_env
  say ""
  printf '  %sSet up Conduit%s\n\n' "$B" "$N"
  if [[ -f "$CONDUIT_DATA_ROOT/auth.json" ]]; then ok "Login password already set"
  else "$NODE" "$RELEASE/scripts/conduit-auth.mjs" set-password </dev/tty >/dev/tty; ok "Login password set"; fi

  choose "Who should be able to open Conduit?" \
    "This computer only ${D}(reach it from elsewhere with Tailscale or a tunnel)${N}" \
    "Any device on my network"
  local host=127.0.0.1; [[ "$REPLY" == 2 ]] && host=0.0.0.0
  ask "Port" "$CONDUIT_PORT"; local port="$REPLY"
  mkdir -p "$STATE_DIR"
  printf 'CONDUIT_HOST=%s\nCONDUIT_PORT=%s\n' "$host" "$port" >"$ENV_FILE"
  ok "Saved to $ENV_FILE"

  step "Preparing the Python tools for spreadsheets and documents"
  sync_python && ok "Python tools ready" || step "Python tools skipped; run: conduit doctor"

  if [[ "$(service_kind)" == systemd ]] && command -v loginctl >/dev/null 2>&1 \
    && [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != yes ]]; then
    loginctl enable-linger "$USER" >/dev/null 2>&1 && ok "Conduit keeps running after you log out" || true
  fi
  start
  load_env
  local url="http://localhost:$CONDUIT_PORT"
  [[ "$CONDUIT_HOST" == 0.0.0.0 ]] && url="http://$(hostname -I 2>/dev/null | awk '{print $1}' || hostname):$CONDUIT_PORT"
  say ""
  printf '  %sOpen %s%s%s\n\n' "$B" "$C" "$url" "$N"
  printf '  %sSign in to your agents (claude, codex, opencode) as you normally would;\n' "$D"
  printf '  Conduit finds them on PATH. Manage it with: conduit status | logs | update%s\n\n' "$N"
}

update() {
  local target="${1:-}"
  exec bash -c "$(curl -fsSL "https://raw.githubusercontent.com/$REPOSITORY/main/scripts/install.sh")" -- --update ${target:+--version "$target"}
}

rollback() {
  local previous
  previous="$(ls -1t "$APP_HOME/versions" | grep -vx "$(basename "$(readlink -f "$APP_HOME/current")")" | head -1 || true)"
  [[ -n "$previous" ]] || fail "No earlier version to return to."
  ln -sfn "$APP_HOME/versions/$previous" "$APP_HOME/current"
  ok "Switched to $previous"; restart
}

doctor() {
  load_env
  printf '  %sConduit %s%s\n' "$B" "$VERSION" "$N"
  [[ -x "$NODE" ]] && ok "Node $("$NODE" --version)" || printf '  %s✗%s Node missing\n' "$R" "$N"
  [[ -x "$RELEASE/working-files/.venv/bin/python" ]] && ok "Python tools" || step "Python tools not installed (conduit setup)"
  [[ -f "$CONDUIT_DATA_ROOT/auth.json" ]] && ok "Login password set" || step "No login password (conduit password)"
  for agent in claude codex opencode2 opencode; do
    command -v "$agent" >/dev/null 2>&1 && ok "$agent on PATH" || step "$agent not found"
  done
  healthy && ok "Server healthy on port $CONDUIT_PORT" || step "Server not running (conduit start)"
}

uninstall() {
  stop >/dev/null 2>&1 || true
  rm -f "$UNIT_FILE" "$PLIST" "$HOME/.local/bin/conduit"
  [[ "$(service_kind)" == systemd ]] && systemctl --user daemon-reload 2>/dev/null || true
  rm -rf "$APP_HOME"
  ok "Removed Conduit. Your data is still in $STATE_DIR"
}

usage() {
  cat <<EOF
${B}conduit${N} $VERSION — the Conduit server on this computer

  ${B}setup${N}       password, who can reach it, and start
  ${B}start${N} / ${B}stop${N} / ${B}restart${N}
  ${B}status${N}      is it running, where, and its data
  ${B}logs${N}        follow the server's log
  ${B}update${N} [v]  install the latest (or a given) release
  ${B}rollback${N}    return to the release before this one
  ${B}password${N}    change the login password
  ${B}doctor${N}      check Node, Python, agents and the server
  ${B}uninstall${N}   remove Conduit, keeping $STATE_DIR
EOF
}

command="${1:-status}"; shift || true
case "$command" in
  setup) setup ;;
  start) start ;;
  stop) stop ;;
  restart) restart ;;
  status) status ;;
  logs) logs ;;
  update) update "$@" ;;
  rollback) rollback ;;
  password) "$NODE" "$RELEASE/scripts/conduit-auth.mjs" set-password ;;
  doctor) doctor ;;
  _sync-python) load_env; sync_python ;;
  uninstall) uninstall ;;
  version|--version|-v) echo "$VERSION" ;;
  help|--help|-h) usage ;;
  *) usage; exit 2 ;;
esac
