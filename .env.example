# Image identity. Release bundles replace development with their exact commit.
CONDUIT_IMAGE=conduit
CONDUIT_RELEASE=development

# Run the unprivileged container as the owner of the bind-mounted directories.
CONDUIT_UID=1000
CONDUIT_GID=1000

# Optional: override Compose's default project name for an isolated deployment.
# CONDUIT_COMPOSE_PROJECT_NAME=conduit

# Fresh VPS deployments are reachable at http://PUBLIC_IP by default.
# Set 127.0.0.1 and a different port for a reverse proxy or Tailscale Serve.
CONDUIT_BIND_ADDRESS=0.0.0.0
CONDUIT_PORT=80

# Relative paths resolve from compose.yaml. Under /srv/conduit this produces
# /srv/conduit/data and /srv/workspaces on the host.
CONDUIT_DATA_DIR=./data
CONDUIT_WORKSPACES_DIR=../workspaces

ENABLE_PARTIAL_CONTINUE=true
