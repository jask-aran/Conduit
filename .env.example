# Production deployments pull the prebuilt image published from main.
CONDUIT_IMAGE=ghcr.io/jask-aran/conduit
CONDUIT_RELEASE=latest
CONDUIT_DEPLOY_MODE=image

# Public hostname. DNS must point this name at the VPS before Caddy can issue HTTPS.
CONDUIT_DOMAIN=conduit.example.com
CADDY_VERSION=2-alpine

# Run the unprivileged application container as the owner of the bind-mounted directories.
CONDUIT_UID=1000
CONDUIT_GID=1000

# Optional: override Compose's default project name for an isolated deployment.
# CONDUIT_COMPOSE_PROJECT_NAME=conduit

# Relative paths resolve from compose.yaml. Under /srv/conduit this produces
# /srv/conduit/data and /srv/workspaces on the host.
CONDUIT_DATA_DIR=./data
CONDUIT_WORKSPACES_DIR=../workspaces

ENABLE_PARTIAL_CONTINUE=true
