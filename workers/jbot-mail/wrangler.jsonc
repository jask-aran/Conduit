{
  // Conduit deploys this itself now; wrangler is for local work.
  // jbot's mailbox (docs/plans/persistent-agent.md, The message log): Email Routing delivers jbot@ here, the Worker keeps
  // each message in R2, and the hub collects it (list, get, delete) behind one shared secret. It sends only to the person's verified addresses.
  "name": "jbot-mail",
  "main": "../../templates/agent/mailbox/worker.js",
  "compatibility_date": "2026-10-01",
  "send_email": [{ "name": "SEND" }],
  "r2_buckets": [{ "binding": "MAIL", "bucket_name": "jbot-mail" }]
}
